#!/bin/bash
# ============================================================
# 3hub - 3xui-hub 管理命令
# ============================================================

VERSION="1.0.0"
INSTALL_DIR="/www/wwwroot/3xui-hub"
BACKEND_DIR="${INSTALL_DIR}/backend"
# 数据库备份目录：与 backend/config/backup.php 的默认值保持一致（env BACKUP_DIR 可覆盖）
BACKUP_DIR="/var/backups/3xui-hub"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查安装
check_install() {
    if [ ! -f "$INSTALL_DIR/server/go.mod" ]; then
        echo -e "${RED}错误: 3xui-hub 未安装或安装目录不正确${NC}"
        exit 1
    fi
}

# node-ops 实例数规则（纯函数，入参 mem_mb，只回显列表）：<1024MB → 1，否则 2。
# 与 install.sh 里的 node_instance_count_for_mem 同一规则；分开两处保持各自可独立运行。

# 解析本机该开几个 node-ops 实例：覆盖文件优先（含数字，空格分隔），否则按 MemTotal 自适应。

# 关闭「已 enabled 但不在名单内」的 node-ops 实例（老机器升级后 2→1 时残留的 @2 必须停掉）。
# 来源是 multi-user.target.wants 下的软链，不写死 1..N —— 人工 enable 过 @3 也能被收敛。

# 展开 node-ops worker 的实例单元名（3xui-hub-queue-node@1.service ...）

# artisan 必须以网站运行用户执行：root 跑会往 storage/bootstrap/cache
# 写 root 属主文件，导致 www-data 的队列 worker 间歇性 Permission denied

# 保障 Laravel 调度器 cron（幂等）：
#   已有 artisan schedule:run 条目 → 原样不动；缺失 → 合并式补写并回显
# 为什么要在更新/自检路径反复保障：root crontab 会被 acme.sh 安装、面板自带 cron
# 管理、其它运维脚本整体重写掉。一旦 schedule:run 丢了，traffic:sync / ban-check /
# health-check / traffic:monthly-reset / async-task-timeout 全部停摆，BanCheckJob 不再
# 写 worker 心跳缓存，后台「系统状态」就会一直显示 worker 离线（其实 worker 好着）。
# 返回 0=已配置（含本次补写），1=需要人工处理（无权限 / 写入失败）


# 配置 xray 节点 WS 长连接服务（3xui-hub-node-ws.service）
#
# 为什么每次 update 都重写单元文件 + 自愈安装：老版本（没有这个服务）升级上来时，
# 不装就会出现「agent 连不上 WS → 降级 HTTP 通道」，功能可用但实时性打折；
# 而且单元文件由脚本统一维护，避免线上手改漂移。restart 失败降级为告警不中断更新
# （WS 挂掉时 agent 会自动降级 HTTP，面板功能不受影响，不应该阻断整个升级流程）。

# nginx /node-ws 反代自愈（幂等）
#
# 本功能发布前安装的老面板，3xui-hub.conf 里没有 /node-ws location —— agent 连 WS 会
# 404，自动降级 HTTP（功能可用但实时性打折）。这里在「location ~ ^/(api|admin-api)」
# 锚点前插入反代块，把 WS 通道补齐。
# 保护：改前备份、nginx -t 校验失败自动回滚，绝不破坏用户的 SSL / 自定义配置。
ensure_nginx_node_ws() {
    local CONF=""
    if [ -d /www/server/panel ] || [ -d /www/server/nginx ]; then
        CONF="/www/server/panel/vhost/nginx/3xui-hub.conf"
    else
        CONF="/etc/nginx/conf.d/3xui-hub.conf"
    fi
    [ -f "$CONF" ] || return 0
    grep -q '/node-ws' "$CONF" 2>/dev/null && grep -q 'node-install' "$CONF" 2>/dev/null && return 0

    cp -f "$CONF" "${CONF}.bak-nodews"
    python3 - "$CONF" <<'PY'
import sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    s = f.read()
blocks = ''
if '/node-ws' not in s:
    blocks += '''    # xray 节点 WS 长连接（agent 主通道；连不上时 agent 自动降级 HTTP）
    location /node-ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

'''
if 'node-install' not in s:
    blocks += '''    # xray 节点资产与安装脚本（Go 后端动态提供）
    location ~ ^/(node-install\\.sh|node-agent\\.sh|node-bin/) {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

'''
if not blocks:
    sys.exit(0)  # 已有，无需处理
anchor = 'location ~ ^/(api|admin-api)'
idx = s.find(anchor)
if idx < 0:
    sys.exit(2)  # 找不到锚点，无法安全插入
line_start = s.rfind('\n', 0, idx) + 1
with open(path, "w", encoding="utf-8") as f:
    f.write(s[:line_start] + blocks + s[line_start:])
PY
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
            echo "Nginx 反代: 已补 /node-ws"
            rm -f "${CONF}.bak-nodews"
        else
            mv -f "${CONF}.bak-nodews" "$CONF"
            echo "Nginx 反代: 补丁未通过 nginx -t，已回滚（可手工添加 /node-ws）"
        fi
    else
        rm -f "${CONF}.bak-nodews"
        [ "$rc" -eq 2 ] && echo "Nginx 反代: 未找到 api|admin-api 锚点，跳过（请手工确认 /node-ws）"
    fi
}

# 把老 PHP 版 nginx 反代完整切到 Go（root backend/public→frontend/dist、
# api/admin-api 与 node-install 的 try_files index.php→proxy_pass 8080、
# 删 php-fpm location、node-ws 8091→8080）。幂等：检测到 Go 特征才跳过。
# 为什么不能只靠 ensure_nginx_node_ws：它只「补」/node-ws + /node-install 的
# proxy_pass，但老 PHP 版 conf 的 root 还指 backend/public、api 还是 try_files
# index.php —— 升级后 PHP 源码已删，前端和 API 会 404，面板整个打不开。
ensure_nginx_go_proxy() {
    local main_conf
    main_conf="$(nginx_conf_path)"
    _go_proxy_patch_file "$main_conf"
    _go_proxy_patch_file "$(dirname "$main_conf")/3xui-hub-domains.conf"
    return 0
}

# 对单个 conf 切 PHP→Go 反代（幂等；文件不存在 / 已切则跳过）
_go_proxy_patch_file() {
    local CONF="$1"
    [ -f "$CONF" ] || return 0

    # 已切 Go 的特征：root 指 frontend/dist 且全文无 index.php 反代
    if grep -q 'frontend/dist' "$CONF" 2>/dev/null && ! grep -q 'index\.php' "$CONF" 2>/dev/null; then
        return 0
    fi

    cp -f "$CONF" "${CONF}.bak-goproxy"
    python3 - "$CONF" <<'PY'
import re, sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    s = f.read()

# 1. root backend/public → frontend/dist
s = re.sub(r'root\s+[^;]*backend/public\s*;', lambda m: m.group(0).replace('backend/public', 'frontend/dist'), s)

# 2. index index.html index.php → index index.html
s = s.replace('index index.html index.php;', 'index index.html;')

# 3. 删 php-fpm location 块（location ~ [^/]\.php(/|$) { ... }）
s = re.sub(r'[ \t]*location ~ \[\^/\]\\\.php\(/\|\$\) \{[^{}]*\}\n?', '', s)

# 4. node-ws 端口 8091 → 8080（PHP 时代 node-ws 独立进程监听 8091）
s = s.replace('127.0.0.1:8091', '127.0.0.1:8080')

# 5. api/admin-api + node-install 的 try_files index.php → proxy_pass 8080
proxy = ('        proxy_pass http://127.0.0.1:8080;\n'
         '        proxy_set_header Host $host;\n'
         '        proxy_set_header X-Real-IP $remote_addr;\n'
         '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n'
         '        proxy_set_header X-Forwarded-Proto $scheme;')
s = re.sub(r'[ \t]*try_files \$uri \$uri/ /index\.php\?\$query_string;', proxy, s)

with open(path, "w", encoding="utf-8") as f:
    f.write(s)
PY
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
            echo "Nginx 反代: 已切到 Go（root=frontend/dist + api→8080）"
            rm -f "${CONF}.bak-goproxy"
        else
            mv -f "${CONF}.bak-goproxy" "$CONF"
            echo "Nginx 反代: 切 Go 补丁未通过 nginx -t，已回滚"
        fi
    else
        rm -f "${CONF}.bak-goproxy"
        echo "Nginx 反代: 切 Go 失败，请手工确认 $CONF"
    fi
}

# nginx 前端缓存规则自愈（幂等）
#
# 为什么需要：Vite 产物文件名带内容哈希，index.html 决定去加载哪批 chunk。
# 若 index.html 没有 Cache-Control，浏览器会按启发式规则自行长期缓存它 —— 升级后
# 浏览器仍拿旧 index 去找旧 chunk，而旧 chunk 在服务器上未必已被清理，于是静默加载
# 一套新旧混杂的前端：页面能开、不报错，但个别功能区块空白，极难排查。
# 给 index.html 加 no-cache、给 /assets/ 加长缓存即可根治。
#
# 覆盖范围：主 conf（3xui-hub.conf）+ 多域名 conf（3xui-hub-domains.conf，表驱动整份
# 重建、存量文件同样要自愈）。锚点用「SPA fallback 完整块」（location / 紧跟
# try_files …/index.html），逐个 server 段补齐 —— 不会误插进只做 301 跳转的 80 段。
# 保护：改前备份、nginx -t 校验失败自动回滚，绝不破坏用户的 SSL / 自定义配置。
ensure_nginx_cache_rules() {
    local main_conf
    main_conf="$(nginx_conf_path)"
    _cache_rules_patch_file "$main_conf"
    _cache_rules_patch_file "$(dirname "$main_conf")/3xui-hub-domains.conf"
    return 0
}

# 对单个 conf 补缓存规则（幂等；文件不存在 / 已含规则则跳过）
_cache_rules_patch_file() {
    local CONF="$1"
    [ -f "$CONF" ] || return 0
    grep -q 'location = /index.html' "$CONF" 2>/dev/null && return 0

    cp -f "$CONF" "${CONF}.bak-cache"
    python3 - "$CONF" <<'PY'
import re
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    s = f.read()

if 'location = /index.html' in s:
    sys.exit(0)  # 已有，无需处理

blocks = '''    # 带内容哈希的构建产物：内容变了文件名必变，可放心长缓存。
    location /assets/ {
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # SPA 入口：绝不能缓存（否则升级后可能拿旧 index 加载旧 chunk）。
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

'''

# 锚点 = SPA fallback 的完整 location 块（含 try_files …/index.html）：
# 80 段「location / { return 301 ... }」这类跳转块不会被命中；
# 命中多个（多域名 conf 每个域名一个 443 段）则逐个补齐。
pattern = re.compile(r'([ \t]*)location / \{[ \t]*\n[ \t]*try_files \$uri \$uri/ /index\.html;')
s, count = pattern.subn(lambda m: blocks + m.group(0), s)

if count == 0:
    # 兜底：自定义 conf 结构 → 退回「第一个 location / {」前的旧锚点（保持旧行为）。
    idx = s.find('location / {')
    if idx < 0:
        idx = s.find('location ~ ^/(api|admin-api)')
    if idx < 0:
        sys.exit(2)
    line_start = s.rfind('\n', 0, idx) + 1
    s = s[:line_start] + blocks + s[line_start:]

with open(path, "w", encoding="utf-8") as f:
    f.write(s)
PY
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
            echo "Nginx 缓存: $(basename "${CONF}") 已补 index.html no-cache + /assets/ 长缓存"
            rm -f "${CONF}.bak-cache"
        else
            mv -f "${CONF}.bak-cache" "$CONF"
            echo "Nginx 缓存: $(basename "${CONF}") 补丁未通过 nginx -t，已回滚"
        fi
    else
        rm -f "${CONF}.bak-cache"
        [ "$rc" -eq 2 ] && echo "Nginx 缓存: $(basename "${CONF}") 未找到插入锚点，跳过"
    fi
    return 0
}

# nginx gzip 自愈（幂等）
#
# 为什么需要：系统 nginx.conf 的 gzip_types 常被注释掉（nginx 默认只压 text/html），
# 表现为「index.html 被压缩、JS/CSS 原样传输」。JS/CSS/JSON 是面板最大的静态资源，
# 实测 gzip 后可省 60~75% 体积，弱网/跨境链路改善明显。
# gzip 指令在 http/server/location 上下文均合法，这里放 server 段内 —— 不受系统配置影响。
# 保护：改前备份、nginx -t 校验失败自动回滚，绝不破坏用户的 SSL / 自定义配置。
ensure_nginx_gzip() {
    local main_conf
    main_conf="$(nginx_conf_path)"
    _gzip_patch_file "$main_conf"
    _gzip_patch_file "$(dirname "$main_conf")/3xui-hub-domains.conf"
    return 0
}

# 对单个 conf 补 gzip 指令（幂等；文件不存在 / 已含 gzip_types 则跳过）
_gzip_patch_file() {
    local CONF="$1"
    [ -f "$CONF" ] || return 0
    grep -q 'gzip_types' "$CONF" 2>/dev/null && return 0

    cp -f "$CONF" "${CONF}.bak-gzip"
    python3 - "$CONF" <<'PY'
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    s = f.read()

if 'gzip_types' in s:
    sys.exit(0)  # 已有，无需处理

block = '''    # 文本资源 gzip：系统 nginx.conf 的 gzip_types 常被注释掉（默认只压 text/html），
    # JS/CSS/JSON 会原样传输；放 server 段内不受系统配置影响（实测省 60~75% 体积）。
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml text/xml application/xml+rss text/javascript image/svg+xml font/ttf font/otf font/woff2;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
'''

# 锚点 = 每个业务 server 段的「index index.html;」行（80 跳转段没有该行）；
# 命中多个（多域名 conf 每个域名一个 443 段）则逐个补齐。Go 化后 index 不含 index.php。
needle = '    index index.html;\n'
if needle not in s:
    sys.exit(2)
s = s.replace(needle, needle + '\n' + block)

with open(path, "w", encoding="utf-8") as f:
    f.write(s)
PY
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
            echo "Nginx gzip: $(basename "${CONF}") 已补文本资源压缩（JS/CSS/JSON）"
            rm -f "${CONF}.bak-gzip"
        else
            mv -f "${CONF}.bak-gzip" "$CONF"
            echo "Nginx gzip: $(basename "${CONF}") 补丁未通过 nginx -t，已回滚"
        fi
    else
        rm -f "${CONF}.bak-gzip"
        [ "$rc" -eq 2 ] && echo "Nginx gzip: $(basename "${CONF}") 未找到插入锚点，跳过"
    fi
    return 0
}

# 修复 storage / bootstrap/cache 属主（幂等自愈）
#
# 为什么更新末尾要单独修一遍：任何以 root 身份跑过 artisan / composer 的动作，都会在这两个
# 目录里留下 root 属主文件 —— cmd_update 里的 composer install（会以 root 触发
# package:discover，往 bootstrap/cache 写 packages.php / services.php），以及运维手工敲的
# php artisan xxx / tinker（排查问题时最容易顺手敲出来）。之后以网站运行用户跑的调度器 /
# 队列 worker 再往 storage/framework/cache 写缓存就 Permission denied，schedule:run 静默失败
# → 定时任务全停 + 面板显示 worker 离线（BanCheckJob 不再写心跳缓存）。所以每次更新都要把
# 属主收回来，否则每更新一次就重新埋一颗雷。
#
# 安静且幂等：先扫一遍有没有非目标属主的文件，没有就一声不响地返回，不做多余动作。
# bootstrap/cache 不能漏 —— composer 的 root 属主文件正写在那里。

# 保障备份目录存在且属主正确（幂等）。
# 为什么需要在更新/安装路径保障：调度器每天 03:30 以网站运行用户跑 backup:run，
# 目录不存在或属主是 root 时每次备份都会失败 —— 而且是在凌晨静默失败，没人会发现。
ensure_backup_dir() {
    local NGINX_USER BAD_SCAN_RC=0

    # 与 run_artisan / fix_storage_ownership 同一套用户判定
    NGINX_USER=$(ps -eo user,comm 2>/dev/null | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    if [ -d "$BACKUP_DIR" ]; then
        # 已存在：只在属主不对时修（扫不出结果按「脏」处理，与 fix_storage_ownership 同口径）
        BAD=$(find "$BACKUP_DIR" ! -user "$NGINX_USER" -print -quit 2>/dev/null) || BAD_SCAN_RC=$?
        if [ "$BAD_SCAN_RC" -eq 0 ] && [ -z "$BAD" ]; then
            return 0
        fi
    else
        mkdir -p "$BACKUP_DIR" 2>/dev/null || true
    fi

    if [ ! -d "$BACKUP_DIR" ]; then
        echo -e "备份目录: ${YELLOW}创建失败${NC}（请手工执行: mkdir -p ${BACKUP_DIR}）"
        return 0
    fi

    # 非 root 改不了属主；mkdir 出来的目录通常已经是当前用户，无需再 chown
    if [ "$(id -u)" -ne 0 ]; then
        chown "$NGINX_USER":"$NGINX_USER" "$BACKUP_DIR" 2>/dev/null || true
        return 0
    fi

    if chown "$NGINX_USER":"$NGINX_USER" "$BACKUP_DIR" 2>/dev/null; then
        echo -e "备份目录: ${GREEN}已就绪${NC}（${BACKUP_DIR} → ${NGINX_USER}）"
    else
        echo -e "备份目录: ${YELLOW}属主未修正${NC}，请手工执行: chown ${NGINX_USER}:${NGINX_USER} ${BACKUP_DIR}"
    fi
    return 0
}

# 遗留超大 laravel.log 归档（幂等）。日志改为按天轮转后，新日志写 laravel-YYYY-MM-DD.log，
# 旧的 laravel.log 不再增长；但升级上来的机器它可能已经是几十 MB，白占空间。
# 超过 5MB 就整体改名 laravel-legacy-<时间戳>.log：保留（不丢历史）但不再增长，
# 轮转后的新日志由 Laravel daily 驱动接管，14 天自动清理。

# 命令列表（编号对应）
CMDS=(
    "status"
    "check-update"
    "update"
    "admin-user"
    "admin-pass"
    "sync"
    "sync-status"
    "backup"
    "log"
    "restart"
    "ssl"
    "domain"
    "fix-nginx"
    "uninstall"
)

CMD_LABELS=(
    "查看系统状态"
    "检测更新"
    "更新系统"
    "修改管理员账号"
    "修改管理员密码"
    "手动同步流量"
    "查看自动同步状态"
    "数据库备份（导出到 /var/backups/3xui-hub，保留 7 份，每天 03:30 自动备份）"
    "查看最近错误日志"
    "重启 PHP-FPM、Nginx 和队列 Worker"
    "配置域名和 SSL 证书"
    "多域名管理 (add/renew/remove/status)"
    "补全 nginx 节点资产 location（老版本升级后用）"
    "卸载面板 (--panel / --app / --all，不带参数进交互菜单)"
)

# 显示帮助
show_help() {
    echo -e "${CYAN}3hub${NC} - 3xui-hub 管理命令 v${VERSION}"
    echo ""
    echo "用法: 3hub [命令|编号]"
    echo ""
    echo "命令:"
    for i in "${!CMDS[@]}"; do
        printf "  ${GREEN}%2d${NC}  %-14s %s\n" $((i+1)) "${CMDS[$i]}" "${CMD_LABELS[$i]}"
    done
    echo ""
    echo "示例:"
    echo "  3hub status"
    echo "  3hub 1          # 等同于 3hub status"
    echo "  3hub domain add example.com"
}

# 查看状态
cmd_status() {
    check_install
    cd "$INSTALL_DIR"

    echo -e "${CYAN}=== 系统状态 ===${NC}"
    echo ""

    # 版本
    echo -e "版本:      ${GREEN}${VERSION}${NC}"

    # 后端版本（预编译二进制分发，版本号与 frontend/package.json 对齐）
    BACKEND_VER=$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' "$INSTALL_DIR/frontend/package.json" 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    echo -e "后端版本:  ${GREEN}${BACKEND_VER:-未知}${NC}"

    # 数据库
    if command -v mysql &>/dev/null; then
        DB_SIZE=$(mysql -u root controlhub -e "SELECT ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) AS size_mb FROM information_schema.tables WHERE table_schema = 'controlhub';" -sN 2>/dev/null)
        echo -e "数据库:    ${GREEN}${DB_SIZE} MB (MySQL)${NC}"
    else
        echo -e "数据库:    ${YELLOW}MySQL${NC}"
    fi

    # 统计（Go 后端直连 MySQL，直接 SQL 查询）
    echo ""
    echo -e "${CYAN}--- 数据统计 ---${NC}"
    mysql -u root controlhub -sN -e "
        SELECT CONCAT('用户:      ', COUNT(*)) FROM users;
        SELECT CONCAT('服务器:    ', COUNT(*)) FROM nodes;
        SELECT CONCAT('节点:      ', COUNT(*)) FROM node_inbounds;
        SELECT CONCAT('套餐:      ', COUNT(*)) FROM plans;
        SELECT CONCAT('订单:      ', COUNT(*)) FROM orders;
        SELECT CONCAT('支付配置:  ', COUNT(*)) FROM payment_configs;
    " 2>/dev/null

    # Nginx 状态
    echo ""
    if systemctl is-active nginx &>/dev/null; then
        echo -e "Nginx:     ${GREEN}运行中${NC}"
    else
        echo -e "Nginx:     ${RED}未运行${NC}"
    fi

    # Go 后端服务（单进程：HTTP + scheduler + WS 内置）
    if systemctl is-active controlhub &>/dev/null; then
        echo -e "Go 后端:   ${GREEN}运行中${NC}（面板 API + 定时调度 + 节点 WS 通道）"
    else
        echo -e "Go 后端:   ${RED}未运行${NC}"
    fi
}

# 取当前代码所在的发布 tag（去掉 v 前缀）。
# 顺序：describe → 补拉 tags 后再 describe → 最后回退 package.json（并告警）。
current_tag() {
    local t
    t=$(git -C "$INSTALL_DIR" describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    if [ -z "$t" ]; then
        # 常见原因：克隆时没拉 tag（浅克隆 / fetch 只取 main）
        git -C "$INSTALL_DIR" fetch --tags --quiet origin 2>/dev/null || true
        t=$(git -C "$INSTALL_DIR" describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    fi
    if [ -z "$t" ]; then
        t=$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' "$INSTALL_DIR/frontend/package.json" 2>/dev/null \
            | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
        [ -n "$t" ] && echo -e "${YELLOW}提示：本地无 git tag，暂用 package.json 版本 ${t} 代替${NC}" >&2
    fi
    printf '%s' "$t"
}

# 取远程最新的发布 tag（去掉 v 前缀）。用 tag 而不是 origin/main 的 commit：
# 只有作者正式打了 tag（= 发了 Release 二进制）才算「有新版本」，
# 否则用户会拉到「有新代码、却没有对应二进制」的中间态。
remote_latest_tag() {
    local url out
    # 先问 origin（正常安装时它就是作者仓库）
    out=$(git -C "$INSTALL_DIR" ls-remote --tags --refs origin 'v*' 2>/dev/null \
        | awk -F/ '{print $NF}' | sed 's/^v//' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
        | sort -V | tail -1)
    # origin 是 fork / 没打 tag 时，直接问上游（镜像优先，直连兜底）
    if [ -z "$out" ]; then
        for url in "https://ghfast.top/https://github.com/YouzSpace/3xui-hub.git" \
                   "https://github.com/YouzSpace/3xui-hub.git"; do
            out=$(git ls-remote --tags --refs "$url" 'v*' 2>/dev/null \
                | awk -F/ '{print $NF}' | sed 's/^v//' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
                | sort -V | tail -1)
            [ -n "$out" ] && break
        done
    fi
    printf '%s' "$out"
}

# 检测更新（以 git tag 为准；commit 哈希仅作版本对应关系的参考）
cmd_check_update() {
    check_install
    cd "$INSTALL_DIR"

    echo -e "${CYAN}检查更新...${NC}"
    git fetch origin --tags 2>/dev/null

    local CUR_TAG NEW_TAG CUR_SHA NEW_SHA COUNT FROM
    CUR_TAG=$(current_tag)
    NEW_TAG=$(remote_latest_tag)
    CUR_SHA=$(git rev-parse --short HEAD 2>/dev/null)

    echo -e "当前版本:  ${GREEN}v${CUR_TAG:-未知}${NC}  (commit ${CUR_SHA})"

    if [ -z "$NEW_TAG" ]; then
        echo -e "${YELLOW}未能获取远程 tag（网络问题或仓库无 tag）${NC}"
        return 1
    fi

    NEW_SHA=$(git rev-list -n1 "v${NEW_TAG}" 2>/dev/null | cut -c1-9)
    echo -e "最新版本:  ${GREEN}v${NEW_TAG}${NC}  (commit ${NEW_SHA:-未知})"

    if [ "$CUR_TAG" = "$NEW_TAG" ]; then
        echo -e "${GREEN}已是最新版本${NC}"
        return 0
    fi

    # 只列「当前所在 tag → 最新 tag」之间的提交 = 这一版包含的改动
    FROM="${CUR_TAG:+v${CUR_TAG}}"
    [ -n "$FROM" ] || FROM=$(git rev-parse HEAD 2>/dev/null)
    COUNT=$(git rev-list --count "$FROM..v${NEW_TAG}" 2>/dev/null || echo 0)

    echo ""
    echo -e "${YELLOW}有新版本可用！${NC}（v${CUR_TAG:-未知} → v${NEW_TAG}，共 ${COUNT} 个提交）"
    echo ""
    echo -e "${CYAN}更新内容:${NC}"
    git log --oneline --no-decorate "$FROM..v${NEW_TAG}" 2>/dev/null \
        | head -10 | sed 's/^[0-9a-f]\{7,9\} /  · /'
    [ "${COUNT:-0}" -gt 10 ] 2>/dev/null && echo "  ...（共 ${COUNT} 条）"
    echo ""
    echo -e "运行 ${BLUE}3hub update${NC} 更新（将下载 v${NEW_TAG} 的预编译二进制）"
}
# php-fpm 并发调优（pm.max_children）
#
# 发行版默认 www.conf 是 5（Debian/Ubuntu），面板一有并发就排队，是用户量上来后第一个卡的环节。
# 必须 root：要改 /etc/php/*/fpm/pool.d/www.conf 并 reload 系统服务，不能走 run_artisan 的降权
#（那个是给「会写 storage/ 属主」的 artisan 命令用的）。
# 幂等：当前值已等于推荐值时不改配置、不 reload。

# 清理历史 CLI opcache 配置（v1.25.1 曾默认开启，v1.25.3 回退为默认关）
#
# 为什么回退：面板常驻进程（队列 worker / WS）由 systemd 各自 fork+exec 拉起，而 OPcache
# 的共享段只能被 fork 的子进程共享，独立进程之间零共享 —— 开启后每个进程反而净增
# 约 7MB（实测；2 核机型 6 个常驻进程合计约 34MB），纯开销。
#
# 老版本升级上来的机器可能残留 v1.25.1 写入的 99-3xui-hub-opcache.ini，所以 update 时
# 以子进程方式调「刚更新到盘上」的这份脚本里的本函数（bash 启动时已把旧函数读进内存，
# 直接调函数在老版本升级那一次跑不到，同 __fpm-tune / ensure_nginx_node_ws 的坑）。
# 必须在 configure_queue_worker 之前跑：worker restart 前删掉 ini，重启后才落到关态。
# php 不可用 / 找不到扫描目录时只提示跳过，不中断更新。
# 注意：本函数名与 __cli-opcache 子命令名不能改 —— 老版本 update 的子进程调用依赖它们。

# 把前端产物同步到 backend/public：先按 dist 清单清理旧版本残留，再复制新文件。
#
# 为什么不能直接 `cp -r`：cp 只覆盖不删除。Vite 产物文件名带内容哈希，每次构建
# 都会产生一批新文件名、旧文件名就此成为垃圾。只覆盖的话历次版本的 chunk 会一直
# 堆在 public 里 —— 浏览器一旦拿到旧的 index.html（它指向旧 chunk），而那些旧
# chunk 恰好还在，就会静默加载到一套新旧混杂的前端：页面能开、不报错，但功能区块
# 空白，极难排查。清掉旧文件能让这种情况立刻暴露成 404，而不是静默错误。
#
# 清理范围严格限定：只删 public 里「有对应 dist 产物」的目录（即 assets/ 与
# favicon.ico 这类静态资源），并跳过 Laravel 必需文件与用户上传目录。
# dist 是被 git 跟踪的（116 个文件），所以 git pull 后它必然等于本次发布的内容，
# 可以放心当权威清单。

# 升级前快照：记下当前 commit（供失败回滚），并尽力做一次数据库备份。
# 快照路径由 cmd_update 第一段算好，经环境变量 HUB_UPDATE_SNAPSHOT 传给 exec 后的 phase2。
# 恒返回 0：快照只是「保险」，拿不到不应把升级本身挡下来。
_update_snapshot() {
    local SNAP="${1:-}" PREV SHORT

    [ -n "$SNAP" ] || return 0

    mkdir -p "$(dirname "$SNAP")" 2>/dev/null || true

    PREV=$(git -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null)
    if [ -z "$PREV" ]; then
        echo -e "${YELLOW}无法读取当前版本，本次升级不生成回滚点${NC}"
        return 0
    fi
    printf '%s\n' "$PREV" > "$SNAP" 2>/dev/null || true

    # 数据库备份：失败仅告警，不阻断升级。回滚只回代码，这份备份是额外保险，
    # 让人工在必要时有数据库回滚点可用。Go 化后直接 mysqldump，不再走 artisan。
    if ! mysqldump -u root controlhub 2>/dev/null | gzip > "${BACKUP_DIR}/pre-update-$(date +%Y%m%d%H%M%S).sql.gz"; then
        echo -e "${YELLOW}数据库备份失败，回滚时将没有数据库回滚点${NC}"
    fi

    SHORT=$(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null)
    echo "更新前快照已保存：${SNAP}（当前版本 ${SHORT}）"
    return 0
}

# 升级失败回滚：代码退回快照 commit，并重启服务、把 CLI 一起退回去。
# 只回代码，不回滚数据库 —— 迁移绝大多数是加表加列，旧代码读写不受影响；
# 最近一次数据库备份在 ${BACKUP_DIR}/，需要时人工取用。
# 快照缺失（「旧版本第一次升级」走的是没有 exec 的旧脚本，环境里不带快照变量）时，
# 用 reflog 的上一条记录兜底；再取不到才放弃并返回 1。
_update_rollback() {
    local SNAP="${1:-}" PREV SHORT u

    [ -n "$SNAP" ] && [ -f "$SNAP" ] && PREV=$(head -n 1 "$SNAP" 2>/dev/null)

    if [ -z "$PREV" ]; then
        PREV=$(git -C "$INSTALL_DIR" rev-parse --verify 'HEAD@{1}' 2>/dev/null)
    fi

    if [ -z "$PREV" ]; then
        echo -e "${RED}无回滚点（快照缺失）${NC}，请人工处理"
        return 1
    fi

    echo -e "${CYAN}正在回滚到升级前版本...${NC}"
    if ! git -C "$INSTALL_DIR" reset --hard "$PREV" 2>&1; then
        # reset 失败时后面所有动作都无意义（代码没退回去），绝不能被下去
        # 打印「已回滚」——那会让人以为收工了。
        echo -e "${RED}回滚失败（git reset 未成功），代码仍停在当前版本，请人工处理${NC}"
        return 1
    fi

    # 下载与旧代码匹配的 Go 二进制（失败告警不中断：回滚中途再断会更难收拾）
    fetch_backend_binary 2>/dev/null \
        || echo -e "${YELLOW}Go 二进制下载失败，请重新运行 3hub update${NC}"

    systemctl restart controlhub 2>/dev/null || true

    # CLI 退回旧版本，与刚 reset 下来的源码保持一致（否则命令行仍是新版逻辑）
    cp "$INSTALL_DIR/3hub" /usr/local/bin/3hub 2>/dev/null || true
    chmod +x /usr/local/bin/3hub 2>/dev/null || true

    SHORT=$(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null)
    echo -e "${GREEN}已回滚到 ${SHORT}。${NC}数据库未自动回滚（迁移通常是加表加列，旧代码兼容）；最近数据库备份在 ${BACKUP_DIR}/"
    return 0
}

# 下载预编译 Go 后端二进制（升级/回滚共用）。版本号读 frontend/package.json 的
# version（与 release tag 对齐），架构由 uname -m 检测；下载到 server/controlhub-server。
# 下载源按序回退：GitHub Release → gh-proxy → ghfast.top。成功返回 0，失败返回 1。
fetch_backend_binary() {
    local VER ARCH BIN URL
    VER=$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' "$INSTALL_DIR/frontend/package.json" 2>/dev/null \
        | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    [ -n "$VER" ] || { echo -e "${RED}无法从 frontend/package.json 读取版本号${NC}"; return 1; }

    case "$(uname -m)" in
        x86_64|amd64) ARCH="amd64" ;;
        aarch64|arm64) ARCH="arm64" ;;
        *) echo -e "${RED}不支持的架构: $(uname -m)${NC}"; return 1 ;;
    esac

    BIN="controlhub-server-linux-${ARCH}"
    URL="https://github.com/YouzSpace/3xui-hub/releases/download/v${VER}/${BIN}"
    # 先下到临时文件再原子替换：curl 直写运行中的二进制会 Text file busy（内核拒绝
    # 覆盖正在执行的文件）；mv 换新 inode 允许覆盖。stop 后由 phase2 的 restart 拉起来。
    local TMP="${INSTALL_DIR}/server/.controlhub-server.new"
    for u in "$URL" "https://gh-proxy.com/$URL" "https://ghfast.top/$URL"; do
        if curl -fL --connect-timeout 15 --max-time 300 -o "$TMP" "$u" 2>/dev/null; then
            chmod +x "$TMP"
            systemctl stop controlhub 2>/dev/null || true
            mv -f "$TMP" "${INSTALL_DIR}/server/controlhub-server"
            return 0
        fi
        echo -e "${YELLOW}下载失败，尝试下一个镜像...${NC}"
    done
    echo -e "${RED}二进制下载失败（已尝试所有镜像）${NC}"
    return 1
}

# 更新系统（两段式：第一段只换代码，随后 exec 重新执行刚落盘的新脚本）
#
# 为什么分两段：bash 启动时把脚本读进内存，git reset 换掉盘上代码后本进程仍跑旧函数，
# 本次新增/修改的自愈逻辑当次一定不生效 —— 历史上靠「逐个改成子进程调用」绕，
# 漏一个就要用户跑两次 update。两段式从结构上消灭这个坑。
cmd_update() {
    check_install
    cd "$INSTALL_DIR"

    echo -e "${CYAN}更新中...${NC}"

    # 第一段：只换代码（清理本地 merge 提交）
    git fetch origin 2>/dev/null

    # 落 reset 之前先记快照：reset 之后本地就没有旧 commit 的可见引用了。
    # 失败也只当保险没买上，照样往下升级（_update_snapshot 恒返回 0）。
    local SNAP="${BACKUP_DIR}/prev-commit-$(date +%Y%m%d%H%M%S).txt"
    _update_snapshot "$SNAP"

    # reset 失败时下面什么都没换，代码仍是旧的，直接退出即可 —— 不需要也不该回滚
    if ! git reset --hard origin/main 2>&1; then
        echo -e "${RED}代码更新失败（git reset 未成功），请检查网络后重试${NC}"
        return 1
    fi

    # 第二段：exec 重新执行刚落盘的新脚本（本进程被替换，exit 码即新脚本退出码）。
    # 此后包括本次新加的自愈在内，全部是新代码，天然当次生效、无需再「记得绕」。
    # 快照路径经环境变量传给 phase2：exec 继承环境，这是两段之间唯一的传参通道。
    HUB_UPDATE_SNAPSHOT="$SNAP" exec bash "$INSTALL_DIR/3hub" __update-phase2
}

# 更新后半段（内部命令；由 cmd_update 第一段 exec 进入，执行时一定是刚落盘的代码）
cmd_update_phase2() {
    check_install
    cd "$INSTALL_DIR"

    local SNAP="${HUB_UPDATE_SNAPSHOT:-}"

    # 下载预编译 Go 二进制（版本号读 package.json，与 release tag 对齐，免编译）
    echo -e "${CYAN}下载 Go 后端二进制...${NC}"
    if ! fetch_backend_binary; then
        _update_rollback "$SNAP"
        return 1
    fi

    # 幂等确保 controlhub.service 存在（老 PHP 机器升级时该 unit 缺失，restart 会找不到）。
    # 已存在则不覆盖（保留用户可能改过的 RestartSec 等）。
    if [ ! -f /etc/systemd/system/controlhub.service ]; then
        echo -e "${CYAN}创建 controlhub.service（老机器升级缺失）...${NC}"
        cat > /etc/systemd/system/controlhub.service << EOF
[Unit]
Description=ControlHub Go 后端（面板 API + 定时调度 + 节点 WS 通道）
After=network.target mysqld.service mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=${INSTALL_DIR}/server
Environment=CONFIG_ENV=${INSTALL_DIR}/backend/.env
Environment=LISTEN_ADDR=:8080
ExecStart=${INSTALL_DIR}/server/controlhub-server
Restart=always
RestartSec=3
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable controlhub 2>/dev/null || true
    fi

    # 重启 Go 后端服务（单进程：HTTP + scheduler + WS 内置）
    systemctl restart controlhub 2>/dev/null || true
    sleep 1
    if ! systemctl is-active --quiet controlhub; then
        echo -e "${RED}Go 后端服务启动失败，请运行: journalctl -u controlhub${NC}"
        _update_rollback "$SNAP"
        return 1
    fi

    # 停用 PHP 相关服务（Go 已替代 php-fpm + queue worker + node-ws）。
    # 幂等：服务不存在时静默跳过；老版本没有这些服务也安全。
    for svc in 3xui-hub-queue 3xui-hub-queue-mail 3xui-hub-node-ws; do
        systemctl stop "$svc" 2>/dev/null || true
        systemctl disable "$svc" 2>/dev/null || true
    done
    for link in /etc/systemd/system/multi-user.target.wants/3xui-hub-queue-node@*.service; do
        [ -e "$link" ] || continue
        local u
        u="$(basename "$link")"
        systemctl stop "$u" 2>/dev/null || true
        systemctl disable "$u" 2>/dev/null || true
    done

    # 老 PHP 版 nginx 反代完整切到 Go（root/api/php-fpm/node-ws 端口）——升级关键
    ensure_nginx_go_proxy
    # 前端缓存规则 + gzip 自愈
    ensure_nginx_cache_rules
    ensure_nginx_gzip

    # 更新 3hub 命令本身
    cp "$INSTALL_DIR/3hub" /usr/local/bin/3hub
    chmod +x /usr/local/bin/3hub

    # 同步多域名助手
    if [ -f "$INSTALL_DIR/3hub-domain" ]; then
        cp "$INSTALL_DIR/3hub-domain" /usr/local/bin/3hub-domain
        chmod +x /usr/local/bin/3hub-domain
        chown root:root /usr/local/bin/3hub-domain 2>/dev/null || true
    fi
    if [ -f "$INSTALL_DIR/sudoers-3xui-hub" ] && visudo -cf "$INSTALL_DIR/sudoers-3xui-hub" >/dev/null 2>&1; then
        cp "$INSTALL_DIR/sudoers-3xui-hub" /etc/sudoers.d/3xui-hub
        chmod 0440 /etc/sudoers.d/3xui-hub
        chown root:root /etc/sudoers.d/3xui-hub 2>/dev/null || true
    fi

    echo -e "${GREEN}更新完成！${NC}"
}

# nginx 反代是否已就位（只读判断，供提示与 fix-nginx 复用）
nginx_conf_path() {
    if [ -d /www/server/panel ] || [ -d /www/server/nginx ]; then
        echo "/www/server/panel/vhost/nginx/3xui-hub.conf"
    else
        echo "/etc/nginx/conf.d/3xui-hub.conf"
    fi
}

nginx_node_ws_applied() {
    local CONF
    CONF="$(nginx_conf_path)"
    [ -f "$CONF" ] || return 0   # 没这份 conf 就不是本脚本该管的场景，视为无需处理
    grep -q '/node-ws' "$CONF" 2>/dev/null && grep -q 'node-install' "$CONF" 2>/dev/null
}

# 补 nginx 反代（给老版本升级上来的机器用；幂等，可反复执行）
cmd_fix_nginx() {
    # 老 PHP 版反代完整切 Go（root/api/php-fpm/node-ws 端口）
    ensure_nginx_go_proxy

    # 顺带补前端缓存规则（幂等）：老 conf 缺 index.html no-cache 时在这里一并修好
    ensure_nginx_cache_rules

    # 顺带补 gzip（幂等）：老 conf 的 JS/CSS 未压缩时一并修好
    ensure_nginx_gzip

    echo -e "${CYAN}检查 nginx 节点资产 location...${NC}"
    if nginx_node_ws_applied; then
        echo -e "Nginx 反代: ${GREEN}已就位${NC}（无需处理）"
        return 0
    fi
    ensure_nginx_node_ws
    if nginx_node_ws_applied; then
        echo -e "Nginx 反代: ${GREEN}已补全${NC}"
        return 0
    fi
    echo -e "${RED}Nginx 反代: 未能补全${NC}，请检查 $(nginx_conf_path) 的写入权限或手工添加"
    return 1
}

# 卸载：只做「找脚本 + 转发」，三档模式和交互菜单都由 uninstall.sh 自己处理。
#
# 不在 3hub 里重复实现卸载逻辑：uninstall.sh 是独立可单独执行的脚本，安装文档
# 也是这么教的；两处各写一份只会随时间漂移（哪个删了哪个没删）。
# 同 fix-nginx 的思路：3hub 是入口，不是第二份实现。
cmd_uninstall() {
    local SCRIPT="${INSTALL_DIR}/uninstall.sh"

    if [ ! -f "$SCRIPT" ]; then
        echo -e "${RED}未找到卸载脚本: ${SCRIPT}${NC}"
        echo "面板目录可能已被删除，或安装路径不是 ${INSTALL_DIR}。"
        return 1
    fi

    # 无参数时先说明三档模式，再交给 uninstall.sh 的交互菜单
    if [ $# -eq 0 ]; then
        echo -e "${CYAN}卸载 3xui-hub${NC}"
        echo "  --panel  仅删面板文件（保留 PHP/Nginx/MySQL 与数据库）"
        echo "  --app    删面板 + 数据库（保留运行环境）"
        echo "  --all    完全卸载（面板 + 数据库 + PHP/Nginx/MySQL）"
        echo ""
        echo -e "${YELLOW}不带参数将进入交互菜单，按提示选择。${NC}"
        echo ""
    fi

    bash "$SCRIPT" "$@"
}

