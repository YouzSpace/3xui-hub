        echo ""
        echo -e "${CYAN}=== Go 后端最近完整日志 ===${NC}"
        journalctl -u controlhub --no-pager -n 30 2>/dev/null || true
    else
        echo -e "${YELLOW}journalctl 不可用${NC}"
    fi
}

