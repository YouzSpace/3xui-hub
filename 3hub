# 修改管理员密码
cmd_admin_pass() {
    check_install

    echo -e "${BLUE}输入新密码（至少6位）:${NC}"
    read -rs NEW_PASS
    echo ""

    if [ ${#NEW_PASS} -lt 6 ]; then
        echo -e "${RED}密码至少6位${NC}"
        return 1
    fi

    # 用 htpasswd 生成 bcrypt（$2y$，Go 的 x/crypto/bcrypt 兼容）；无 htpasswd 时提示走面板
    if ! command -v htpasswd &>/dev/null; then
        echo -e "${RED}缺少 htpasswd（apache2-utils），请通过面板修改密码${NC}"
        return 1
    fi
    HASH=$(htpasswd -bnBC 12 "" "$NEW_PASS" | cut -d: -f2)
    mysql -u root controlhub -e "UPDATE admins SET password='${HASH}' WHERE id=(SELECT MIN(id) FROM admins);" 2>/dev/null
    echo -e "${GREEN}管理员密码已修改${NC}"
}

