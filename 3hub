# 配置域名和 SSL
cmd_ssl() {
    check_install
    echo -e "${CYAN}配置域名和 SSL${NC}"
    echo ""
    echo -e "当前配置:"
    CURRENT_URL=$(grep APP_URL "$BACKEND_DIR/.env" 2>/dev/null | cut -d= -f2)
    echo -e "  APP_URL: ${GREEN}$CURRENT_URL${NC}"
    echo ""

    read -rp "请输入域名或 IP（直接回车取消）: " DOMAIN
    if [ -z "$DOMAIN" ]; then
        echo -e "${YELLOW}已取消${NC}"
        return 0
    fi

    # 判别输入类型：IPv6 / IPv4 / 域名。
    # IP 走 Let's Encrypt IP 证书（shortlived profile，约 6 天、acme.sh 自动续期）。
    # 域名分支 ACME_PROFILE_ARGS 保持为空 —— 参数与行为完全不变（回归）。
    ACME_PROFILE_ARGS=()
    if echo "$DOMAIN" | grep -q ':'; then
        echo -e "${YELLOW}暂不支持 IPv6 证书申请，请改用 IPv4 或域名${NC}"
        return 0
    elif echo "$DOMAIN" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
        echo -e "${CYAN}检测到 IPv4，将申请 Let's Encrypt IP 证书${NC}"
        echo -e "  有效期约 6 天 · acme.sh 自动续期"
        echo -e "  ${YELLOW}需 80 端口对公网开放（安全组）${NC}"
        ACME_PROFILE_ARGS=(--certificate-profile shortlived --days 3)
    fi

    echo ""
    echo -e "是否开启 SSL？"
    read -rp "(y/N): " SSL_CHOICE

    if [ "$SSL_CHOICE" = "y" ] || [ "$SSL_CHOICE" = "Y" ]; then
        # 安装 acme.sh
        if [ ! -f "$HOME/.acme.sh/acme.sh" ]; then
            echo -e "${BLUE}安装 acme.sh...${NC}"
            curl -s https://get.acme.sh | sh 2>&1 | tail -1
        fi

        # 申请证书（用 pipefail 捕获 acme.sh 真实退出码）
        echo -e "${BLUE}申请 SSL 证书...${NC}"
        set -o pipefail
        ACME_OUTPUT=$($HOME/.acme.sh/acme.sh --issue -d "$DOMAIN" --webroot "$BACKEND_DIR/public" "${ACME_PROFILE_ARGS[@]}" --server letsencrypt --reloadcmd "systemctl reload nginx" 2>&1)
        ACME_EXIT=$?
        set +o pipefail
        echo "$ACME_OUTPUT" | tail -5

        # 检查是否证书已存在且有效（acme.sh 返回非 0 但证书实际有效）
        if [ $ACME_EXIT -ne 0 ]; then
            if echo "$ACME_OUTPUT" | grep -qi "Domains not changed\|already exists\|Skipping"; then
                echo -e "${YELLOW}证书已存在且有效，跳过申请${NC}"
            else
                echo -e "${RED}SSL 申请失败，请确保域名已解析到本机 IP${NC}"
                return 1
            fi
        fi

        mkdir -p /etc/nginx/ssl
        # --reloadcmd 必须带上：acme.sh 自动续期后靠它重载 nginx，否则新证书落盘但 nginx 仍发旧证
        $HOME/.acme.sh/acme.sh --install-cert -d "$DOMAIN" \
            --key-file /etc/nginx/ssl/${DOMAIN}.key \
            --fullchain-file /etc/nginx/ssl/${DOMAIN}.pem \
            --reloadcmd "systemctl reload nginx" 2>&1 | tail -1

        # 验证证书文件存在
        if [ ! -f "/etc/nginx/ssl/${DOMAIN}.pem" ] || [ ! -f "/etc/nginx/ssl/${DOMAIN}.key" ]; then
            echo -e "${RED}证书文件生成失败${NC}"
            return 1
        fi

        PROTO="https"
        cat > /etc/nginx/conf.d/3xui-hub.conf << 'NGINX_SSL'
server {
    listen 80;
    server_name DOMAIN_PLACEHOLDER;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name DOMAIN_PLACEHOLDER;
    root BACKEND_PLACEHOLDER/public;
    index index.html index.php;

    ssl_certificate /etc/nginx/ssl/DOMAIN_PLACEHOLDER.pem;
    ssl_certificate_key /etc/nginx/ssl/DOMAIN_PLACEHOLDER.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location ~ [^/]\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~ ^/(api|admin-api) {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 带内容哈希的构建产物：内容变了文件名必变，可放心长缓存。
    location /assets/ {
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # SPA 入口：绝不能缓存。它决定去加载哪批 chunk，一旦被浏览器启发式缓存，
    # 升级后就会拿旧 index 去找旧 chunk（旧文件若恰好还在则静默跑新旧混杂的前端）。
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(env|git) {
        return 404;
    }
}
NGINX_SSL
        # 替换占位符
        sed -i "s|DOMAIN_PLACEHOLDER|${DOMAIN}|g" /etc/nginx/conf.d/3xui-hub.conf
        sed -i "s|BACKEND_PLACEHOLDER|${BACKEND_DIR}|g" /etc/nginx/conf.d/3xui-hub.conf
    else
        PROTO="http"
        cat > /etc/nginx/conf.d/3xui-hub.conf << 'NGINX_HTTP'
server {
    listen 80;
    server_name DOMAIN_PLACEHOLDER;
    root BACKEND_PLACEHOLDER/public;
    index index.html index.php;

    location ~ [^/]\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~ ^/(api|admin-api) {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 带内容哈希的构建产物：可放心长缓存（理由同 HTTPS 段）。
    location /assets/ {
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # SPA 入口：绝不能缓存（理由同 HTTPS 段）。
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(env|git) {
        return 404;
    }
}
NGINX_HTTP
        sed -i "s|DOMAIN_PLACEHOLDER|${DOMAIN}|g" /etc/nginx/conf.d/3xui-hub.conf
        sed -i "s|BACKEND_PLACEHOLDER|${BACKEND_DIR}|g" /etc/nginx/conf.d/3xui-hub.conf
    fi

    # 上面重写了整份 conf：模板未含节点通道（/node-ws 长连接 + node-install 资产）两段，
    # 直接覆盖会把它们冲掉 → 节点连不上面板。复用 fix-nginx 的幂等实现补回（锚点在 api 段前）。
    ensure_nginx_node_ws

    # 更新 .env
    sed -i "s|APP_URL=.*|APP_URL=${PROTO}://${DOMAIN}|" "$BACKEND_DIR/.env"

    # 测试并重载
    if nginx -t 2>&1; then
        systemctl reload nginx 2>/dev/null || systemctl start nginx 2>/dev/null
        echo ""
        echo -e "${GREEN}配置完成！${NC}"
        echo -e "访问地址: ${CYAN}${PROTO}://${DOMAIN}/${NC}"
    else
        echo -e "${RED}Nginx 配置错误，请检查${NC}"
        return 1
    fi
}

cmd_restart() {
    echo -e "${CYAN}重启服务...${NC}"

    # PHP-FPM
    if systemctl is-active php8.4-fpm &>/dev/null; then
        systemctl reload php8.4-fpm
        echo -e "PHP-FPM: ${GREEN}已重启${NC}"
    elif pgrep -f "php-fpm" &>/dev/null; then
        pkill -USR2 php-fpm
        echo -e "PHP-FPM: ${GREEN}已重启${NC}"
    fi

    # Nginx
    if systemctl is-active nginx &>/dev/null; then
        systemctl reload nginx
        echo -e "Nginx:   ${GREEN}已重启${NC}"
    fi

    # 队列 Worker：default（定时任务）+ node-ops（节点任务）
    if systemctl is-active "$QUEUE_SERVICE" &>/dev/null; then
        systemctl restart "$QUEUE_SERVICE"
        echo -e "队列 Worker: ${GREEN}已重启${NC}（default）"
    fi
    if [ ! -f "$NODE_QUEUE_UNIT_FILE" ]; then
        echo -e "节点 Worker: ${YELLOW}未安装${NC}（运行 3hub update 安装 node-ops worker）"
    else
        for u in $(node_queue_units); do
            # restart 会顺带拉起已停止的实例，这正是这里想要的语义
            systemctl restart "$u"
            echo -e "节点 Worker: ${GREEN}已重启${NC}（$u）"
        done
    fi

    # 节点 WS 长连接服务（xray 节点实时通道）
    if systemctl is-active "$NODE_WS_SERVICE" &>/dev/null; then
        systemctl restart "$NODE_WS_SERVICE"
        echo -e "节点 WS 服务: ${GREEN}已重启${NC}（$NODE_WS_SERVICE）"
    else
        echo -e "节点 WS 服务: ${YELLOW}未安装或未运行${NC}（运行 3hub update 安装）"
    fi

    echo -e "${GREEN}服务重启完成${NC}"
}

# 多域名管理用法
cmd_domain_usage() {
    echo -e "${CYAN}用法:${NC} 3hub domain {add|renew|remove|status} <域名>"
    echo ""
    echo -e "  ${GREEN}add${NC}    <域名>  登记域名并申请证书（等效面板「添加域名」）"
    echo -e "  ${GREEN}renew${NC}  <域名>  强制续签证书"
    echo -e "  ${GREEN}remove${NC} <域名>  按 domains 表重建 Nginx 配置（需先在面板删除）"
    echo -e "  ${GREEN}status${NC} <域名>  查看该域名证书状态"
    echo ""
    echo "示例:"
    echo "  3hub domain add example.com"
}

# 多域名管理（手动兜底，调用 /usr/local/bin/3hub-domain）
cmd_domain() {
    local SUB="${1-}"
    local DOMAIN="${2-}"
    local DOMAIN_HELPER="/usr/local/bin/3hub-domain"
    local NGINX_USER

    if [ -z "$SUB" ]; then
        cmd_domain_usage
        return 1
    fi

    case "$SUB" in
        add|renew|remove|status)
            ;;
        *)
            echo -e "${RED}未知子命令: $SUB${NC}"
            echo ""
            cmd_domain_usage
            return 1
            ;;
    esac

    if [ -z "$DOMAIN" ]; then
        echo -e "${RED}缺少域名参数${NC}"
        echo ""
        cmd_domain_usage
        return 1
    fi

    if [ ! -x "$DOMAIN_HELPER" ]; then
        echo -e "${RED}错误: 未找到 ${DOMAIN_HELPER}${NC}"
        echo -e "请重新运行安装脚本，或执行 ${BLUE}3hub update${NC}"
        return 1
    fi

    # add = 面板「添加域名」的命令行等价：面板走 Controller 写库，命令行没有应用层，
    # 这里按同一语义先落 domains 表（幂等；表内无 enabled 行时设为主域），再透传助手 apply。
    # 其余子命令语义不变；remove 沿用「需先在面板删除」的现有口径。
    if [ "$SUB" = "add" ]; then
        if [[ "$DOMAIN" =~ ^[A-Za-z0-9.-]+$ ]] && command -v mysql >/dev/null 2>&1; then
            local DB_NAME ENABLED_CNT IS_PRIMARY
            DB_NAME=$(grep -oP '^DB_DATABASE=\K.*' "$BACKEND_DIR/.env" 2>/dev/null || echo "controlhub")
            ENABLED_CNT=$(mysql -u root -N -B "$DB_NAME" -e "SELECT COUNT(*) FROM domains WHERE enabled=1;" 2>/dev/null || echo 0)
            IS_PRIMARY=0
            [ "${ENABLED_CNT:-0}" = "0" ] && IS_PRIMARY=1
            mysql -u root "$DB_NAME" -e \
                "INSERT INTO domains (domain, is_primary, enabled, ssl_status, created_at, updated_at) VALUES ('${DOMAIN}', ${IS_PRIMARY}, 1, 'pending', NOW(), NOW()) ON DUPLICATE KEY UPDATE enabled=1;" 2>/dev/null \
                && echo -e "${GREEN}domains 表已登记: ${DOMAIN}${NC}" \
                || echo -e "${YELLOW}domains 表登记失败（已存在或 DB 不可达），继续助手流程${NC}"
        fi
        SUB="apply"
    fi

    # 3hub-domain 以 root 执行；非 root 时走 sudo（面板 www-data 走受限 sudoers）
    if [ "$(id -u)" -eq 0 ]; then
        if [ "$SUB" = "apply" ]; then
            # 命令行 apply 后与面板 apply 路径保持数据一致：按助手 JSON 回写域名页状态
            local OUT EXP
            OUT=$("$DOMAIN_HELPER" "$SUB" "$DOMAIN")
            echo "$OUT"
            if echo "$OUT" | grep -q '"ssl_status":"ok"'; then
                EXP=$(echo "$OUT" | grep -oP '"cert_expires_at":"\K[^"]*' | head -1)
                if [ -n "$EXP" ]; then
                    EXP="${EXP%Z}"; EXP="${EXP/T/ }"
                    mysql -u root "${DB_NAME:-controlhub}" -e \
                        "UPDATE domains SET ssl_status='ok', cert_expires_at='${EXP}' WHERE domain='${DOMAIN}';" 2>/dev/null || true
                fi
            fi
        else
            "$DOMAIN_HELPER" "$SUB" "$DOMAIN"
        fi
    else
        NGINX_USER=$(ps -eo user,comm | grep nginx | awk '{print $1}' | grep -v root | head -1)
        NGINX_USER=${NGINX_USER:-www-data}
        if [ "$(id -un)" = "$NGINX_USER" ]; then
            # 网站运行用户：受限 sudoers 免密
            sudo -n "$DOMAIN_HELPER" "$SUB" "$DOMAIN"
        else
            sudo "$DOMAIN_HELPER" "$SUB" "$DOMAIN"
        fi
    fi
}

# 卸载面板
#
# 转发到项目自带的 uninstall.sh（三种模式：--panel / --app / --all）。
# 不在 3hub 里重复实现卸载逻辑：uninstall.sh 是独立可单独执行的脚本，
# 安装文档里也是这么教的；3hub 只做「路径探查 + 转发」，避免两处漂移。
cmd_uninstall() {
    local SCRIPT="${INSTALL_DIR}/uninstall.sh"

    if [ ! -f "$SCRIPT" ]; then
        echo -e "${RED}未找到卸载脚本: ${SCRIPT}${NC}"
        echo -e "请确认安装目录完整，或重新运行安装脚本。"
        return 1
    fi

    # 无参数时先给一眼模式说明再转发（uninstall.sh 自己会弹交互菜单）
    if [ $# -eq 0 ]; then
        echo -e "${YELLOW}即将进入卸载流程，三种模式：${NC}"
        echo -e "  ${BLUE}--panel${NC}  仅删面板文件（保留环境+数据库，适合重装）"
        echo -e "  ${BLUE}--app${NC}    删面板+数据库（保留运行环境）"
        echo -e "  ${BLUE}--all${NC}    完全卸载（面板+数据库+PHP/Nginx/MySQL）"
        echo ""
        echo -e "${YELLOW}非交互请带模式参数，如: 3hub uninstall --panel${NC}"
        echo ""
    fi

    bash "$SCRIPT" "$@"
}

# 执行命令
run_cmd() {
    local CMD="$1"
    if [[ "$CMD" =~ ^[0-9]+$ ]]; then
        local IDX=$((CMD - 1))
        if [ "$IDX" -ge 0 ] && [ "$IDX" -lt "${#CMDS[@]}" ]; then
            CMD="${CMDS[$IDX]}"
        else
            echo -e "${RED}无效编号: $CMD（1-${#CMDS[@]}）${NC}"
            return 1
        fi
    fi

    case "$CMD" in
        status)       cmd_status ;;
        check-update) cmd_check_update ;;
        update)       cmd_update ;;
        admin-user)   cmd_admin_user ;;
        admin-pass)   cmd_admin_pass ;;
        sync)         cmd_sync ;;
        sync-status)  cmd_sync_status ;;
        backup)       cmd_backup ;;
        log)          cmd_log ;;
        restart)      cmd_restart ;;
        fix-nginx)    cmd_fix_nginx ;;
        ssl)          cmd_ssl ;;
        domain)       shift; cmd_domain "$@" ;;
        uninstall)    shift; cmd_uninstall "$@" ;;
        # 内部命令：只给 install.sh 安装期调用，让安装脚本和 3hub 复用同一份 cron 保障
        # 逻辑（旧版两处各写一份，更新路径那份没人管，线上丢过条目）。不列进帮助菜单。
        # 保底：v1.26.x 及更老版本的 update 会以子进程方式调用前三个内部命令，
        # 名字不能改、不能删（老脚本靠它们当次生效）；__update-phase2 由新版
        # cmd_update 第一段 exec 进入，不要手动执行（跑之前必须已 git reset）。
        __ensure-cron) ensure_artisan_cron ;;
        __update-phase2) cmd_update_phase2 ;;
        __fpm-tune)    shift; cmd_fpm_tune "$@" ;;
        __cli-opcache) cmd_cli_opcache ;;
        help|--help|-h) show_help ;;
        *)
            echo -e "${RED}未知命令: $CMD${NC}"
            echo ""
            show_help
            return 1
            ;;
    esac
}

# 实例数在命令分发前解析一次：status / restart / update / log 都读同一个 NODE_QUEUE_INSTANCES，
# 覆盖文件或内存一变，全部自动跟随（不再需要手工同步脚本里的常量）。
NODE_QUEUE_INSTANCES=$(resolve_node_queue_instances)

# 主逻辑
if [ -n "$1" ]; then
    # 有参数：直接执行（透传全部参数，domain 子命令需要）
    run_cmd "$@"
    exit $?
else
    # 无参数：交互式菜单
    show_help
    echo ""
    read -p "请输入编号或命令: " INPUT
    if [ -n "$INPUT" ]; then
        run_cmd "$INPUT"
        exit $?
    fi
fi
