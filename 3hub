# 查看状态
cmd_status() {
    check_install
    cd "$BACKEND_DIR"

    echo -e "${CYAN}=== 系统状态 ===${NC}"
    echo ""

    # 版本
    echo -e "版本:      ${GREEN}${VERSION}${NC}"

    # PHP
    PHP_VER=$(php -r 'echo PHP_VERSION;' 2>/dev/null)
    echo -e "PHP:       ${GREEN}${PHP_VER}${NC}"

    # 数据库
    if command -v mysql &>/dev/null; then
        DB_SIZE=$(mysql -u root controlhub -e "SELECT ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) AS size_mb FROM information_schema.tables WHERE table_schema = 'controlhub';" -sN 2>/dev/null)
        echo -e "数据库:    ${GREEN}${DB_SIZE} MB (MySQL)${NC}"
    else
        echo -e "数据库:    ${YELLOW}MySQL${NC}"
    fi

    # 统计
    echo ""
    echo -e "${CYAN}--- 数据统计 ---${NC}"
    run_artisan tinker --execute="
        echo '用户:      ' . \App\Models\User::count() . PHP_EOL;
        echo '服务器:    ' . \App\Models\Node::count() . PHP_EOL;
        echo '节点:      ' . \App\Models\NodeInbound::count() . PHP_EOL;
        echo '套餐:      ' . \App\Models\Plan::count() . PHP_EOL;
        echo '订单:      ' . \App\Models\Order::count() . PHP_EOL;
        echo '支付配置:  ' . \App\Models\PaymentConfig::count() . PHP_EOL;
    " 2>/dev/null

    # Nginx 状态
    echo ""
    if systemctl is-active nginx &>/dev/null; then
        echo -e "Nginx:     ${GREEN}运行中${NC}"
    else
        echo -e "Nginx:     ${RED}未运行${NC}"
    fi

    # PHP-FPM 状态
    if systemctl is-active php8.4-fpm &>/dev/null || pgrep -f "php-fpm" &>/dev/null; then
        echo -e "PHP-FPM:   ${GREEN}运行中${NC}"
    else
        echo -e "PHP-FPM:   ${RED}未运行${NC}"
    fi

    if systemctl is-active "$QUEUE_SERVICE" &>/dev/null; then
        echo -e "队列 Worker: ${GREEN}运行中${NC}（default，定时任务）"
    else
        echo -e "队列 Worker: ${RED}未运行${NC}（default，定时任务）"
    fi

    # 节点任务 Worker（node-ops）：按实例统计，可能被人工增减
    local NODE_TOTAL=0 NODE_ACTIVE=0 u
    for u in $(node_queue_units); do
        NODE_TOTAL=$((NODE_TOTAL + 1))
        if systemctl is-active "$u" &>/dev/null; then
            NODE_ACTIVE=$((NODE_ACTIVE + 1))
        fi
    done
    if [ "$NODE_TOTAL" -eq 0 ]; then
        echo -e "节点 Worker: ${YELLOW}未配置${NC}（node-ops）"
    elif [ "$NODE_ACTIVE" -eq "$NODE_TOTAL" ]; then
        echo -e "节点 Worker: ${GREEN}运行中${NC}（node-ops，${NODE_ACTIVE}/${NODE_TOTAL}）"
    elif [ "$NODE_ACTIVE" -eq 0 ]; then
        echo -e "节点 Worker: ${RED}未运行${NC}（node-ops，0/${NODE_TOTAL}）"
        echo -e "  ${YELLOW}节点任务会一直停在 pending，修复: 3hub update${NC}"
    else
        echo -e "节点 Worker: ${YELLOW}部分运行${NC}（node-ops，${NODE_ACTIVE}/${NODE_TOTAL}）"
    fi

    # xray 节点 WS 长连接服务（agent 主通道；未运行时节点自动走 HTTP 降级）
    if systemctl is-active "$NODE_WS_SERVICE" &>/dev/null; then
        echo -e "节点 WS 服务: ${GREEN}运行中${NC}（xray 节点实时通道）"
    else
        echo -e "节点 WS 服务: ${YELLOW}未运行${NC}（xray 节点走 HTTP 降级通道，修复: 3hub update）"
    fi
}

# 检测更新
cmd_check_update() {
    check_install
    cd "$INSTALL_DIR"

    echo -e "${CYAN}检查更新...${NC}"
    git fetch origin 2>/dev/null

    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main 2>/dev/null)

    if [ "$LOCAL" = "$REMOTE" ]; then
        echo -e "${GREEN}已是最新版本${NC}"
    else
        # 检查是否落后于远程（而不是领先）
        BEHIND=$(git rev-list --count HEAD..origin/main 2>/dev/null)
        if [ "$BEHIND" -gt 0 ] 2>/dev/null; then
            echo -e "${YELLOW}有新版本可用！${NC}（落后 ${BEHIND} 个提交）"
            echo ""
            git log --oneline HEAD..origin/main 2>/dev/null | head -10
            echo ""
            echo -e "运行 ${BLUE}3hub update${NC} 更新"
        else
            echo -e "${GREEN}已是最新版本${NC}（本地领先远程）"
        fi
    fi
}

# php-fpm 并发调优（pm.max_children）
#
# 发行版默认 www.conf 是 5（Debian/Ubuntu），面板一有并发就排队，是用户量上来后第一个卡的环节。
# 必须 root：要改 /etc/php/*/fpm/pool.d/www.conf 并 reload 系统服务，不能走 run_artisan 的降权
#（那个是给「会写 storage/ 属主」的 artisan 命令用的）。
# 幂等：当前值已等于推荐值时不改配置、不 reload。
cmd_fpm_tune() {
    check_install
    cd "$BACKEND_DIR" || return 1

    php artisan fpm:tune "$@"
}

# 清理历史 CLI opcache 配置（v1.25.1 曾默认开启，v1.25.3 回退为默认关）
#
# 为什么回退：面板常驻进程（队列 worker / WS）由 systemd 各自 fork+exec 拉起，而 OPcache
# 的共享段只能被 fork 的子进程共享，独立进程之间零共享 —— 开启后每个进程反而净增
# 约 7MB（实测；2 核机型 6 个常驻进程合计约 34MB），纯开销。
#
# 老版本升级上来的机器可能残留 v1.25.1 写入的 99-3xui-hub-opcache.ini，所以 update 时
# 以子进程方式调「刚更新到盘上」的这份脚本里的本函数（bash 启动时已把旧函数读进内存，
# 直接调函数在老版本升级那一次跑不到，同 __fpm-tune / ensure_nginx_node_ws 的坑）。
# 必须在 configure_queue_worker 之前跑：worker restart 前删掉 ini，重启后才落到关态。
# php 不可用 / 找不到扫描目录时只提示跳过，不中断更新。
# 注意：本函数名与 __cli-opcache 子命令名不能改 —— 老版本 update 的子进程调用依赖它们。
cmd_cli_opcache() {
    if ! command -v php >/dev/null 2>&1; then
        echo -e "CLI opcache: ${YELLOW}跳过${NC}（php 不可用）"
        return 0
    fi

    local scan_dir ini
    scan_dir=$(php --ini 2>/dev/null | awk -F': ' '/Scan for additional .ini files in/ {print $2; exit}')
    if [ -z "$scan_dir" ] || [ "$scan_dir" = "(none)" ] || [ ! -d "$scan_dir" ]; then
        echo -e "CLI opcache: ${YELLOW}跳过${NC}（未找到 php ini 扫描目录）"
        return 0
    fi

    ini="${scan_dir}/99-3xui-hub-opcache.ini"
    if [ -f "$ini" ]; then
        rm -f "$ini"
        echo -e "CLI opcache: ${GREEN}已清理历史残留配置${NC}（${ini}）"
    else
        echo -e "CLI opcache: ${GREEN}无需清理${NC}"
    fi
    return 0
}

# 把前端产物同步到 backend/public：先按 dist 清单清理旧版本残留，再复制新文件。
#
# 为什么不能直接 `cp -r`：cp 只覆盖不删除。Vite 产物文件名带内容哈希，每次构建
# 都会产生一批新文件名、旧文件名就此成为垃圾。只覆盖的话历次版本的 chunk 会一直
# 堆在 public 里 —— 浏览器一旦拿到旧的 index.html（它指向旧 chunk），而那些旧
# chunk 恰好还在，就会静默加载到一套新旧混杂的前端：页面能开、不报错，但功能区块
# 空白，极难排查。清掉旧文件能让这种情况立刻暴露成 404，而不是静默错误。
#
# 清理范围严格限定：只删 public 里「有对应 dist 产物」的目录（即 assets/ 与
# favicon.ico 这类静态资源），并跳过 Laravel 必需文件与用户上传目录。
# dist 是被 git 跟踪的（116 个文件），所以 git pull 后它必然等于本次发布的内容，
# 可以放心当权威清单。
_sync_frontend_dist() {
    local DIST="$INSTALL_DIR/frontend/dist"
    local PUB="$BACKEND_DIR/public"
    local removed=0 f rel

    if [ ! -d "$DIST" ]; then
        echo -e "${YELLOW}未找到 $DIST，跳过前端产物同步${NC}"
        return 0
    fi

    # 1) 清理：public/assets 里有、dist/assets 里没有的 = 旧版本残留
    if [ -d "$PUB/assets" ] && [ -d "$DIST/assets" ]; then
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            if [ ! -e "$DIST/assets/$f" ]; then
                rm -rf "$PUB/assets/$f" && removed=$((removed + 1))
            fi
        done < <(ls -1 "$PUB/assets" 2>/dev/null)
    fi

    # 2) top-level 的哈希资源（如 favicon-<hash>.ico / *.css 等）：
    #    只处理「dist 顶层存在同名同类、但哈希不同」的情况，绝不能删 index.php 等。
    if [ -d "$DIST" ]; then
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            case "$f" in
                # Laravel / 用户资产，永不清理
                index.php|.htaccess|robots.txt|favicon.ico|storage|uploads|.well-known) continue ;;
            esac
            # 是文件才算；且只在「dist 顶层没有这个文件」时删
            if [ -f "$PUB/$f" ] && [ ! -e "$DIST/$f" ]; then
                rm -f "$PUB/$f" && removed=$((removed + 1))
            fi
        done < <(ls -1 "$PUB" 2>/dev/null)
    fi

    # 3) 复制新产物（保留原语义：失败不阻断升级）
    cp -r "$DIST/"* "$PUB/" 2>/dev/null || true

    if [ "$removed" -gt 0 ]; then
        echo -e "${CYAN}前端产物同步：清理旧版本残留 ${removed} 项${NC}"
    fi
    return 0
}

# 升级前快照：记下当前 commit（供失败回滚），并尽力做一次数据库备份。
# 快照路径由 cmd_update 第一段算好，经环境变量 HUB_UPDATE_SNAPSHOT 传给 exec 后的 phase2。
# 恒返回 0：快照只是「保险」，拿不到不应把升级本身挡下来。
_update_snapshot() {
    local SNAP="${1:-}" PREV SHORT

    [ -n "$SNAP" ] || return 0

    mkdir -p "$(dirname "$SNAP")" 2>/dev/null || true

    PREV=$(git -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null)
    if [ -z "$PREV" ]; then
        echo -e "${YELLOW}无法读取当前版本，本次升级不生成回滚点${NC}"
        return 0
    fi
    printf '%s\n' "$PREV" > "$SNAP" 2>/dev/null || true

    # 数据库备份：失败仅告警，不阻断升级。回滚只回代码，这份备份是额外保险，
    # 让人工在必要时有数据库回滚点可用。
    # 注意 cwd：本函数在 cmd_update 里被调用时 cwd 是 $INSTALL_DIR（根目录没有
    # artisan 文件），run_artisan 内部不 cd —— 必须先进 backend 再跑，否则必然
    # 报「Could not open input file: artisan」，备份永远失败。
    if ! (cd "$BACKEND_DIR" 2>/dev/null && run_artisan backup:run); then
        echo -e "${YELLOW}数据库备份失败，回滚时将没有数据库回滚点${NC}"
    fi

    SHORT=$(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null)
    echo "更新前快照已保存：${SNAP}（当前版本 ${SHORT}）"
    return 0
}

# 升级失败回滚：代码退回快照 commit，并重启服务、把 CLI 一起退回去。
# 只回代码，不回滚数据库 —— 迁移绝大多数是加表加列，旧代码读写不受影响；
# 最近一次数据库备份在 ${BACKUP_DIR}/，需要时人工取用。
# 快照缺失（「旧版本第一次升级」走的是没有 exec 的旧脚本，环境里不带快照变量）时，
# 用 reflog 的上一条记录兜底；再取不到才放弃并返回 1。
_update_rollback() {
    local SNAP="${1:-}" PREV SHORT u

    [ -n "$SNAP" ] && [ -f "$SNAP" ] && PREV=$(head -n 1 "$SNAP" 2>/dev/null)

    if [ -z "$PREV" ]; then
        PREV=$(git -C "$INSTALL_DIR" rev-parse --verify 'HEAD@{1}' 2>/dev/null)
    fi

    if [ -z "$PREV" ]; then
        echo -e "${RED}无回滚点（快照缺失）${NC}，请人工处理"
        return 1
    fi

    echo -e "${CYAN}正在回滚到升级前版本...${NC}"
    if ! git -C "$INSTALL_DIR" reset --hard "$PREV" 2>&1; then
        # reset 失败时后面所有动作都无意义（代码没退回去），绝不能被下去
        # 打印「已回滚」——那会让人以为收工了。
        echo -e "${RED}回滚失败（git reset 未成功），代码仍停在当前版本，请人工处理${NC}"
        return 1
    fi

    # 回装与旧代码匹配的依赖（失败告警不中断：回滚中途再断会更难收拾）
    cd "$BACKEND_DIR" 2>/dev/null || true
    COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --optimize-autoloader 2>&1 \
        || echo -e "${YELLOW}依赖回装失败，请手工执行: cd ${BACKEND_DIR} && composer install --no-dev --optimize-autoloader${NC}"

    run_artisan config:clear 2>&1
    run_artisan route:clear 2>&1
    run_artisan view:clear 2>&1

    systemctl restart "$QUEUE_SERVICE" 2>/dev/null || true
    for u in $(node_queue_units); do
        systemctl restart "$u" 2>/dev/null || true
    done

    systemctl reload php8.4-fpm 2>/dev/null || pkill -USR2 php-fpm 2>/dev/null || true

    # CLI 退回旧版本，与刚 reset 下来的源码保持一致（否则命令行仍是新版逻辑）
    cp "$INSTALL_DIR/3hub" /usr/local/bin/3hub 2>/dev/null || true
    chmod +x /usr/local/bin/3hub 2>/dev/null || true

    # 回滚里的 composer 以 root 跑过，收回 storage/bootstrap/cache 属主
    fix_storage_ownership

    SHORT=$(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null)
    echo -e "${GREEN}已回滚到 ${SHORT}。${NC}数据库未自动回滚（迁移通常是加表加列，旧代码兼容）；最近数据库备份在 ${BACKUP_DIR}/"
    return 0
}

# 更新系统（两段式：第一段只换代码，随后 exec 重新执行刚落盘的新脚本）
#
# 为什么分两段：bash 启动时把脚本读进内存，git reset 换掉盘上代码后本进程仍跑旧函数，
# 本次新增/修改的自愈逻辑当次一定不生效 —— 历史上靠「逐个改成子进程调用」绕，
# 漏一个就要用户跑两次 update。两段式从结构上消灭这个坑。
cmd_update() {
    check_install
    cd "$INSTALL_DIR"

    echo -e "${CYAN}更新中...${NC}"

    # 第一段：只换代码（清理本地 merge 提交）
    git fetch origin 2>/dev/null

    # 落 reset 之前先记快照：reset 之后本地就没有旧 commit 的可见引用了。
    # 失败也只当保险没买上，照样往下升级（_update_snapshot 恒返回 0）。
    local SNAP="${BACKUP_DIR}/prev-commit-$(date +%Y%m%d%H%M%S).txt"
    _update_snapshot "$SNAP"

    # reset 失败时下面什么都没换，代码仍是旧的，直接退出即可 —— 不需要也不该回滚
    if ! git reset --hard origin/main 2>&1; then
        echo -e "${RED}代码更新失败（git reset 未成功），请检查网络后重试${NC}"
        return 1
    fi

    # 第二段：exec 重新执行刚落盘的新脚本（本进程被替换，exit 码即新脚本退出码）。
    # 此后包括本次新加的自愈在内，全部是新代码，天然当次生效、无需再「记得绕」。
    # 快照路径经环境变量传给 phase2：exec 继承环境，这是两段之间唯一的传参通道。
    HUB_UPDATE_SNAPSHOT="$SNAP" exec bash "$INSTALL_DIR/3hub" __update-phase2
}

# 更新后半段（内部命令；由 cmd_update 第一段 exec 进入，执行时一定是刚落盘的代码）
cmd_update_phase2() {
    check_install
    cd "$INSTALL_DIR"

    # 升级前快照路径（由 cmd_update 第一段经环境变量传入）。
    # 为空属预期：老版本的第一次升级走的是没有 exec 的旧脚本，环境里不会带这个变量，
    # 那时 _update_rollback 会退回 reflog 兜底。
    local SNAP="${HUB_UPDATE_SNAPSHOT:-}"

    # 更新后端依赖
    cd "$BACKEND_DIR"
    if ! COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --optimize-autoloader 2>&1; then
        echo -e "${RED}依赖更新失败${NC}"
        _update_rollback "$SNAP"
        return 1
    fi

    # 迁移数据库
    if ! run_artisan migrate --force 2>&1; then
        echo -e "${RED}数据库迁移失败${NC}"
        _update_rollback "$SNAP"
        return 1
    fi

    # 保障调度器 cron（幂等）：root crontab 常被 acme.sh / 面板等工具整体重写，
    # 更新路径必须每次自愈，否则 schedule:run 一丢就是「定时任务全停 + 心跳空白」
    echo -e "${CYAN}检查定时任务...${NC}"
    ensure_artisan_cron || echo -e "${YELLOW}定时任务未就绪，见上方提示${NC}"

    # 备份目录自愈（幂等）：调度器每天 03:30 以网站运行用户跑 backup:run，
    # 目录缺失或属主为 root 会导致凌晨静默失败，所以更新路径每次保障。
    ensure_backup_dir

    # 遗留大日志自愈（幂等）：老版本 upgrade 上来时 storage/logs/laravel.log 可能已经
    # 涨到几十 MB。改版后新日志按天写 laravel-YYYY-MM-DD.log，这个旧文件不会再有新内容，
    # 但它永远占着空间；超过阈值就整体改名归档（保留、不再增长），便于人工排查后删除。
    rotate_legacy_laravel_log

    # CLI opcache：清理 v1.25.1 的残留 ini（回退为默认关）；必须在 worker 重启前完成，
    # 否则 worker 起来时读到的还是旧配置。两段式 exec 后这里已是新代码，直接调。
    echo -e "${CYAN}清理 CLI opcache 残留...${NC}"
    cmd_cli_opcache

    # 配置数据库队列和常驻 Worker（内部会 restart 各 worker，重启后落到清理后的配置）
    configure_queue_worker

    # xray 节点 WS 长连接服务（自愈安装 + 重启；失败仅告警：agent 会降级 HTTP 通道）
    echo -e "${CYAN}检查节点 WS 服务...${NC}"
    if configure_node_ws; then
        echo -e "节点 WS 服务: ${GREEN}已就绪${NC}"
    else
        echo -e "${YELLOW}节点 WS 服务未就绪（节点将使用 HTTP 降级通道，不影响功能）${NC}"
        echo -e "${YELLOW}排查: systemctl status $NODE_WS_SERVICE${NC}"
    fi

    # 清除缓存
    run_artisan config:clear 2>&1
    run_artisan route:clear 2>&1
    run_artisan view:clear 2>&1
    run_artisan queue:restart 2>&1
    systemctl restart "$QUEUE_SERVICE"
    if ! systemctl is-active --quiet "$QUEUE_SERVICE"; then
        echo -e "${RED}后台任务 Worker 启动失败，请运行: systemctl status $QUEUE_SERVICE${NC}"
        _update_rollback "$SNAP"
        return 1
    fi

    # 节点任务 Worker：上面的 configure_queue_worker 会重新生成模板单元并 enable，
    # 所以从老版本（那时还没有这个服务）升级上来也会被装上，这里再逐个 restart + 自检。
    # 必须自检：.env 开了 node-ops 而没有 worker 监听时，节点任务会被派进空队列，
    # 永远不执行且不报错（面板上一直 pending），比两类任务抢队列严重得多。
    for u in $(node_queue_units); do
        systemctl restart "$u"
        if ! systemctl is-active --quiet "$u"; then
            echo -e "${RED}节点任务 Worker ($u) 启动失败，请运行: systemctl status $u${NC}"
            _update_rollback "$SNAP"
            return 1
        fi
    done

    # 复制前端产物（先清旧版本残留再复制，避免历次 chunk 堆积）
    _sync_frontend_dist

    # 前端缓存规则自愈：老版本 conf 缺 index.html no-cache，升级时幂等补上
    ensure_nginx_cache_rules

    # gzip 自愈：老版本 conf 的 JS/CSS 未压缩（系统 gzip_types 被注释），升级时幂等补上
    ensure_nginx_gzip

    # php-fpm 并发（pm.max_children）：发行版默认 5，用户量上来就排队，是第一个卡的地方。
    # 两段式 exec 后这里已是新代码（旧版「必须子进程绕」的坑已结构性消灭），直接调。
    echo -e "${CYAN}检查 php-fpm 并发...${NC}"
    if ! cmd_fpm_tune; then
        echo -e "${YELLOW}php-fpm 并发未调整（可手动执行: cd $BACKEND_DIR && php artisan fpm:tune）${NC}"
    fi

    # agent 自升级：把面板上这份 agent 二进制推给节点（节点自己下载 → sha256 校验 → 原子替换 →
    # 重启 agent）。离线节点也会入队，等它上线取走即执行 —— 不用登录每台 VPS。
    # 幂等：节点已上报同版本 / 已有在途指令 → 跳过，不会每次 update 都重启节点。
    echo -e "${CYAN}检查节点 agent 版本...${NC}"
    if ! run_artisan node:upgrade-agent; then
        echo -e "${YELLOW}agent 升级指令未下发（可手动执行: cd $BACKEND_DIR && php artisan node:upgrade-agent）${NC}"
    fi

    # 重启 PHP-FPM
    systemctl reload php8.4-fpm 2>/dev/null || pkill -USR2 php-fpm 2>/dev/null || true

    # 更新 3hub 命令本身
    cp "$INSTALL_DIR/3hub" /usr/local/bin/3hub
    chmod +x /usr/local/bin/3hub

    # 同步多域名助手（与 install.sh 的 install_domain_support 一致，覆盖更新）
    if [ -f "$INSTALL_DIR/3hub-domain" ]; then
        cp "$INSTALL_DIR/3hub-domain" /usr/local/bin/3hub-domain
        chmod +x /usr/local/bin/3hub-domain
        chown root:root /usr/local/bin/3hub-domain 2>/dev/null || true
    fi
    if [ -f "$INSTALL_DIR/sudoers-3xui-hub" ] && visudo -cf "$INSTALL_DIR/sudoers-3xui-hub" >/dev/null 2>&1; then
        cp "$INSTALL_DIR/sudoers-3xui-hub" /etc/sudoers.d/3xui-hub
        chmod 0440 /etc/sudoers.d/3xui-hub
        chown root:root /etc/sudoers.d/3xui-hub 2>/dev/null || true
    fi

    # 属主自愈：必须压在最后 —— 上面所有可能以 root 跑 artisan / composer 的步骤都跑完了
    #（composer install 的 package:discover、run_artisan 之外的任何手工 php artisan），
    # 这里把 storage / bootstrap/cache 的 root 属主文件收回网站运行用户名下。
    # 顺序上不能提到 config:clear 那类步骤之前，否则还会被后续步骤重新污染。详见函数注释。
    fix_storage_ownership

    # 兜底落盘检查：两段式之后正常不会再缺；但「v1.26.x 及更老版本 → 本版本」的
    # 第一次升级走的是旧脚本（没有 exec），新自愈当次不生效 —— 明确提示，
    # 避免用户以为已自愈、实际还要再跑一条命令。
    if ! nginx_node_ws_applied; then
        echo ""
        echo -e "${YELLOW}⚠ 检测到 nginx 缺少节点资产 location（/node-ws、/node-install.sh）。${NC}"
        echo -e "${YELLOW}  这是老版本升级的已知情况：自愈函数要到下一次运行才可用。${NC}"
        echo -e "${YELLOW}  请执行一次：${NC} ${GREEN}3hub fix-nginx${NC}"
    fi

    echo -e "${GREEN}更新完成！${NC}"
}

# nginx 反代是否已就位（只读判断，供提示与 fix-nginx 复用）
nginx_conf_path() {
    if [ -d /www/server/panel ] || [ -d /www/server/nginx ]; then
        echo "/www/server/panel/vhost/nginx/3xui-hub.conf"
    else
        echo "/etc/nginx/conf.d/3xui-hub.conf"
    fi
}

nginx_node_ws_applied() {
    local CONF
    CONF="$(nginx_conf_path)"
    [ -f "$CONF" ] || return 0   # 没这份 conf 就不是本脚本该管的场景，视为无需处理
    grep -q '/node-ws' "$CONF" 2>/dev/null && grep -q 'node-install' "$CONF" 2>/dev/null
}

# 补 nginx 反代（给老版本升级上来的机器用；幂等，可反复执行）
cmd_fix_nginx() {
    # 顺带补前端缓存规则（幂等）：老 conf 缺 index.html no-cache 时在这里一并修好
    ensure_nginx_cache_rules

    # 顺带补 gzip（幂等）：老 conf 的 JS/CSS 未压缩时一并修好
    ensure_nginx_gzip

    echo -e "${CYAN}检查 nginx 节点资产 location...${NC}"
    if nginx_node_ws_applied; then
        echo -e "Nginx 反代: ${GREEN}已就位${NC}（无需处理）"
        return 0
    fi
    ensure_nginx_node_ws
    if nginx_node_ws_applied; then
        echo -e "Nginx 反代: ${GREEN}已补全${NC}"
        return 0
    fi
    echo -e "${RED}Nginx 反代: 未能补全${NC}，请检查 $(nginx_conf_path) 的写入权限或手工添加"
    return 1
}

# 修改管理员账号
cmd_admin_user() {
    check_install
    cd "$BACKEND_DIR"

    echo -e "${CYAN}当前管理员账号:${NC}"
    run_artisan tinker --execute="echo \App\Models\Admin::first()->username;" 2>/dev/null
    echo ""
    echo -e "${BLUE}输入新用户名:${NC}"
    read -r NEW_USER

    if [ -z "$NEW_USER" ]; then
        echo -e "${RED}用户名不能为空${NC}"
        return 1
    fi

    if [ ${#NEW_USER} -lt 3 ]; then
        echo -e "${RED}用户名至少3位${NC}"
        return 1
    fi

    run_artisan tinker --execute="
        \$admin = \App\Models\Admin::first();
        \$admin->username = '${NEW_USER}';
        \$admin->save();
        echo '已修改为: ' . \$admin->username;
    " 2>/dev/null

    echo -e "${GREEN}管理员账号已修改${NC}"
}

# 修改管理员密码
cmd_admin_pass() {
    check_install
    cd "$BACKEND_DIR"

    echo -e "${BLUE}输入新密码（至少6位）:${NC}"
    read -rs NEW_PASS
    echo ""

    if [ ${#NEW_PASS} -lt 6 ]; then
        echo -e "${RED}密码至少6位${NC}"
        return 1
    fi

    run_artisan tinker --execute="
        \$admin = \App\Models\Admin::first();
        \$admin->password = bcrypt('${NEW_PASS}');
        \$admin->save();
        echo '密码已修改';
    " 2>/dev/null

    echo -e "${GREEN}管理员密码已修改${NC}"
}

# 手动同步流量
cmd_sync() {
    check_install
    cd "$BACKEND_DIR"

    echo -e "${CYAN}开始同步流量...${NC}"
    run_artisan traffic:sync 2>&1
}

# 查看同步状态
cmd_sync_status() {
    check_install

    echo -e "${CYAN}=== 自动同步状态 ===${NC}"
    echo ""

    # 检查 cron：缺失时顺带补齐（自检路径同时是修复路径，口径改成「已自动修复」）
    ensure_artisan_cron || true

    # 检查日志中的同步记录
    LOG_FILE="$BACKEND_DIR/storage/logs/laravel.log"
    if [ -f "$LOG_FILE" ]; then
        LAST_SYNC=$(grep -i "traffic:sync\|流量同步\|同步完成" "$LOG_FILE" 2>/dev/null | tail -1)
        if [ -n "$LAST_SYNC" ]; then
            echo ""
            echo -e "最近同步记录:"
            echo "  $LAST_SYNC"
        else
            echo ""
            echo -e "最近同步记录: ${YELLOW}暂无${NC}"
        fi
    fi

    # 检查 Scheduler 运行状态
    echo ""
    cd "$BACKEND_DIR"
    echo -e "${CYAN}调度任务列表:${NC}"
    run_artisan schedule:list 2>/dev/null | head -10
}

# 导出备份
#
# 逻辑全部收在 artisan backup:run（config/backup.php 控制目录/保留份数/dump 路径）：
#   - 落盘 /var/backups/3xui-hub（不再是重启即丢的 /tmp）；
#   - 成功后只保留最新 7 份，不会反复执行无限堆积；
#   - dump 失败删除半截文件并以非 0 退出（这里直接透传 artisan 的返回码）。
# 同一个命令也被调度器每天 03:30 调用，手动与自动走完全相同的实现。
cmd_backup() {
    check_install
    cd "$BACKEND_DIR"

    if ! run_artisan backup:run; then
        echo -e "${RED}备份失败${NC}（常见原因：mysqldump 不可用、数据库连接失败、磁盘空间不足）"
        return 1
    fi
}

# 查看日志
cmd_log() {
    check_install

    # 日志已按天轮转（laravel-YYYY-MM-DD.log），不再固定读 laravel.log：
    # 取 storage/logs 下 mtime 最新的 laravel*.log（含升级时归档的 laravel-legacy-*.log）。
    # 老版本升级上来的机器若只有 laravel.log，它同样是候选，行为向后兼容。
    LOG_FILE=$(ls -1t "$BACKEND_DIR"/storage/logs/laravel*.log 2>/dev/null | head -1)

    if [ -z "$LOG_FILE" ] || [ ! -f "$LOG_FILE" ]; then
        echo -e "${YELLOW}暂无日志${NC}"
        return
    fi

    echo -e "日志文件: ${LOG_FILE##*/}"

    echo -e "${CYAN}=== 最近错误日志 ===${NC}"
    grep -i "ERROR\|EXCEPTION\|CRITICAL" "$LOG_FILE" 2>/dev/null | tail -20

    if [ ! -s "$LOG_FILE" ]; then
        echo -e "${GREEN}暂无错误${NC}"
    fi

    # 队列 Worker 的单元日志：worker 被 OOM/超时杀掉后自动重启这类事只记在 journal 里，
    # laravel.log 上看不到（Job 失败栈在 laravel.log，进程级问题在这里）
    if command -v journalctl &>/dev/null; then
        local JOURNAL_ARGS=(-u "$QUEUE_SERVICE") u
        for u in $(node_queue_units); do
            JOURNAL_ARGS+=(-u "$u")
        done
        echo ""
        echo -e "${CYAN}=== 队列 Worker 最近日志（default + node-ops） ===${NC}"
        journalctl "${JOURNAL_ARGS[@]}" --no-pager -n 20 2>/dev/null || true
    fi
}

