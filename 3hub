# 导出备份
#
# 逻辑全部收在 artisan backup:run（config/backup.php 控制目录/保留份数/dump 路径）：
#   - 落盘 /var/backups/3xui-hub（不再是重启即丢的 /tmp）；
#   - 成功后只保留最新 7 份，不会反复执行无限堆积；
#   - dump 失败删除半截文件并以非 0 退出（这里直接透传 artisan 的返回码）。
# 同一个命令也被调度器每天 03:30 调用，手动与自动走完全相同的实现。
cmd_backup() {
    check_install

    local BACKUP_DIR="/var/backups/3xui-hub"
    mkdir -p "$BACKUP_DIR"
    local TS
    TS=$(date +%Y%m%d%H%M%S)
    local FILE="$BACKUP_DIR/backup-${TS}.sql.gz"

    if ! command -v mysqldump &>/dev/null; then
        echo -e "${RED}mysqldump 不可用，无法备份${NC}"
        return 1
    fi

    if ! mysqldump -u root controlhub 2>/dev/null | gzip > "$FILE"; then
        echo -e "${RED}备份失败${NC}（常见原因：数据库连接失败、磁盘空间不足）"
        rm -f "$FILE"
        return 1
    fi

    # 只保留最新 7 份（与 scheduler 的 backup:run 一致）
    ls -1t "$BACKUP_DIR"/backup-*.sql.gz 2>/dev/null | tail -n +8 | xargs -r rm -f

    echo -e "${GREEN}备份完成: $FILE${NC}"
}

cmd_log() {
