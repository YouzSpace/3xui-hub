# 多域名管理（手动兜底，调用 /usr/local/bin/3hub-domain）
cmd_domain() {
    local SUB="${1-}"
    local DOMAIN="${2-}"
    local DOMAIN_HELPER="/usr/local/bin/3hub-domain"
    local NGINX_USER

    if [ -z "$SUB" ]; then
        cmd_domain_usage
        return 1
    fi

    case "$SUB" in
        add|renew|remove|status)
            ;;
        *)
            echo -e "${RED}未知子命令: $SUB${NC}"
            echo ""
            cmd_domain_usage
            return 1
            ;;
    esac

    if [ -z "$DOMAIN" ]; then
        echo -e "${RED}缺少域名参数${NC}"
        echo ""
        cmd_domain_usage
        return 1
    fi

    if [ ! -x "$DOMAIN_HELPER" ]; then
        echo -e "${RED}错误: 未找到 ${DOMAIN_HELPER}${NC}"
        echo -e "请重新运行安装脚本，或执行 ${BLUE}3hub update${NC}"
        return 1
    fi

    # 3hub-domain 以 root 执行；非 root 时走 sudo（面板 www-data 走受限 sudoers）
    if [ "$(id -u)" -eq 0 ]; then
        "$DOMAIN_HELPER" "$SUB" "$DOMAIN"
    else
        NGINX_USER=$(ps -eo user,comm | grep nginx | awk '{print $1}' | grep -v root | head -1)
        NGINX_USER=${NGINX_USER:-www-data}
        if [ "$(id -un)" = "$NGINX_USER" ]; then
            # 网站运行用户：受限 sudoers 免密
            sudo -n "$DOMAIN_HELPER" "$SUB" "$DOMAIN"
        else
            sudo "$DOMAIN_HELPER" "$SUB" "$DOMAIN"
        fi
    fi
}

# 执行命令
run_cmd() {
    local CMD="$1"
    if [[ "$CMD" =~ ^[0-9]+$ ]]; then
        local IDX=$((CMD - 1))
        if [ "$IDX" -ge 0 ] && [ "$IDX" -lt "${#CMDS[@]}" ]; then
            CMD="${CMDS[$IDX]}"
        else
            echo -e "${RED}无效编号: $CMD（1-${#CMDS[@]}）${NC}"
            return 1
        fi
    fi

    case "$CMD" in
        status)       cmd_status ;;
        check-update) cmd_check_update ;;
        update)       cmd_update ;;
        admin-user)   cmd_admin_user ;;
        admin-pass)   cmd_admin_pass ;;
        sync)         cmd_sync ;;
        sync-status)  cmd_sync_status ;;
        backup)       cmd_backup ;;
        log)          cmd_log ;;
        restart)      cmd_restart ;;
        fix-nginx)    cmd_fix_nginx ;;
        ssl)          cmd_ssl ;;
        domain)       shift; cmd_domain "$@" ;;
        # 内部命令：只给 install.sh 安装期调用，让安装脚本和 3hub 复用同一份 cron 保障
        # 逻辑（旧版两处各写一份，更新路径那份没人管，线上丢过条目）。不列进帮助菜单。
        __ensure-cron) ensure_artisan_cron ;;
        __fpm-tune)    shift; cmd_fpm_tune "$@" ;;
        help|--help|-h) show_help ;;
        *)
            echo -e "${RED}未知命令: $CMD${NC}"
            echo ""
            show_help
            return 1
            ;;
    esac
}

# 主逻辑
if [ -n "$1" ]; then
    # 有参数：直接执行（透传全部参数，domain 子命令需要）
    run_cmd "$@"
    exit $?
else
    # 无参数：交互式菜单
    show_help
    echo ""
    read -p "请输入编号或命令: " INPUT
    if [ -n "$INPUT" ]; then
        run_cmd "$INPUT"
        exit $?
    fi
fi
