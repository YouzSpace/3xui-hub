#!/bin/bash
# ============================================================
# 3hub - 3xui-hub 管理命令
# ============================================================

VERSION="1.0.0"
INSTALL_DIR="/www/wwwroot/3xui-hub"
BACKEND_DIR="${INSTALL_DIR}/backend"
QUEUE_SERVICE="3xui-hub-queue.service"
# 节点任务专用队列（node-ops）的 worker：模板单元 + 实例编号，命令只写一份。
# 要增减并发实例，改 NODE_QUEUE_INSTANCES 并照 configure_queue_worker 里的
# systemctl enable/disable 操作即可（详见 INSTALL.md「队列与并发」）。
NODE_QUEUE_TEMPLATE="3xui-hub-queue-node@"
NODE_QUEUE_UNIT_FILE="/etc/systemd/system/3xui-hub-queue-node@.service"
NODE_QUEUE_INSTANCES="1 2"
# xray 节点 WebSocket 长连接服务（Workerman 常驻；nginx 反代 /node-ws → 127.0.0.1:8091）
NODE_WS_SERVICE="3xui-hub-node-ws.service"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查安装
check_install() {
    if [ ! -f "$BACKEND_DIR/artisan" ]; then
        echo -e "${RED}错误: 3xui-hub 未安装或安装目录不正确${NC}"
        exit 1
    fi
}

# 展开 node-ops worker 的实例单元名（3xui-hub-queue-node@1.service ...）
node_queue_units() {
    local i
    for i in $NODE_QUEUE_INSTANCES; do
        echo "${NODE_QUEUE_TEMPLATE}${i}.service"
    done
}

# artisan 必须以网站运行用户执行：root 跑会往 storage/bootstrap/cache
# 写 root 属主文件，导致 www-data 的队列 worker 间歇性 Permission denied
run_artisan() {
    local NGINX_USER
    NGINX_USER=$(ps -eo user,comm | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}
    sudo -u "$NGINX_USER" php artisan "$@"
}

# 保障 Laravel 调度器 cron（幂等）：
#   已有 artisan schedule:run 条目 → 原样不动；缺失 → 合并式补写并回显
# 为什么要在更新/自检路径反复保障：root crontab 会被 acme.sh 安装、面板自带 cron
# 管理、其它运维脚本整体重写掉。一旦 schedule:run 丢了，traffic:sync / ban-check /
# health-check / traffic:monthly-reset / async-task-timeout 全部停摆，BanCheckJob 不再
# 写 worker 心跳缓存，后台「系统状态」就会一直显示 worker 离线（其实 worker 好着）。
# 返回 0=已配置（含本次补写），1=需要人工处理（无权限 / 写入失败）
ensure_artisan_cron() {
    local NGINX_USER CRON_CMD CURRENT

    # 必须用网站运行用户执行：root 直跑会持续往 storage/framework/cache 写 root 属主
    # 缓存文件，导致 www-data 的队列 worker 间歇性 Permission denied
    NGINX_USER=$(ps -eo user,comm 2>/dev/null | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    CRON_CMD="* * * * * sudo -u ${NGINX_USER} bash -c 'cd ${BACKEND_DIR} && php artisan schedule:run >> /dev/null 2>&1'"

    CURRENT=$(crontab -l 2>/dev/null)
    if printf '%s\n' "$CURRENT" | grep -q "artisan schedule:run"; then
        echo -e "Cron 定时任务: ${GREEN}已配置${NC}（schedule:run 以 ${NGINX_USER} 运行）"
        return 0
    fi

    # 非 root 只提示不改写：那样写进的是当前用户自己的 crontab，看似修复实则永不生效
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "Cron 定时任务: ${YELLOW}未配置${NC}（写入 root crontab 需要 root 权限，请用 sudo 运行）"
        return 1
    fi

    # 合并式写入：只剔除同名旧条目再追加，acme.sh 等其它条目必须原样保留。
    # 绝不能用 `crontab <文件>` 整体覆盖——那会把别人的条目一并吞掉。
    if ! { [ -n "$CURRENT" ] && printf '%s\n' "$CURRENT" | grep -v "artisan schedule:run"; echo "$CRON_CMD"; } | crontab -; then
        echo -e "Cron 定时任务: ${RED}写入失败${NC}，请手工执行 crontab -e 添加："
        echo "  $CRON_CMD"
        return 1
    fi

    echo -e "Cron 定时任务: ${GREEN}已自动补配${NC}（schedule:run 以 ${NGINX_USER} 运行，此前缺失）"
    return 0
}

configure_queue_worker() {
    NGINX_USER=$(ps -eo user,comm | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    if grep -q '^QUEUE_CONNECTION=' "$BACKEND_DIR/.env"; then
        sed -i 's/^QUEUE_CONNECTION=.*/QUEUE_CONNECTION=database/' "$BACKEND_DIR/.env"
    else
        echo 'QUEUE_CONNECTION=database' >> "$BACKEND_DIR/.env"
    fi
    if grep -q '^DB_QUEUE_RETRY_AFTER=' "$BACKEND_DIR/.env"; then
        sed -i 's/^DB_QUEUE_RETRY_AFTER=.*/DB_QUEUE_RETRY_AFTER=180/' "$BACKEND_DIR/.env"
    else
        echo 'DB_QUEUE_RETRY_AFTER=180' >> "$BACKEND_DIR/.env"
    fi

    # 节点类 Job 走独立队列 node-ops。已有该行则改写，没有才追加（不重复追加：
    # dotenv 以最后一行为准，重复行会让旧值残留在文件里，排查时极易看错）。
    # 顺序上必须排在下面启动 worker 之前，否则会先出现「worker 监听 node-ops、
    # Job 仍往 default 派」的空转窗口。
    if grep -q '^PANEL_NODE_OPS_QUEUE=' "$BACKEND_DIR/.env"; then
        sed -i 's/^PANEL_NODE_OPS_QUEUE=.*/PANEL_NODE_OPS_QUEUE=node-ops/' "$BACKEND_DIR/.env"
    else
        echo 'PANEL_NODE_OPS_QUEUE=node-ops' >> "$BACKEND_DIR/.env"
    fi

    chown "$NGINX_USER":"$NGINX_USER" "$BACKEND_DIR/.env" 2>/dev/null || true
    chmod 640 "$BACKEND_DIR/.env" 2>/dev/null || true
    chown -R "$NGINX_USER":"$NGINX_USER" "$BACKEND_DIR/storage" "$BACKEND_DIR/bootstrap/cache" 2>/dev/null || true
    chmod -R 775 "$BACKEND_DIR/storage" "$BACKEND_DIR/bootstrap/cache" 2>/dev/null || true

    cat > "/etc/systemd/system/$QUEUE_SERVICE" << EOF
[Unit]
Description=3xui-hub Queue Worker
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=${NGINX_USER}
Group=${NGINX_USER}
WorkingDirectory=${BACKEND_DIR}
ExecStart=/usr/bin/php artisan queue:work database --sleep=2 --tries=5 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=130

[Install]
WantedBy=multi-user.target
EOF

    # node-ops worker：模板单元 + 实例编号，命令行只写一份，实例共用，
    # 避免两份文件只改一份导致某个实例漏掉 --queue=node-ops 而和 default worker 抢同一条队列。
    cat > "$NODE_QUEUE_UNIT_FILE" << EOF
[Unit]
Description=3xui-hub Node Ops Queue Worker (instance %i)
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=${NGINX_USER}
Group=${NGINX_USER}
WorkingDirectory=${BACKEND_DIR}
ExecStart=/usr/bin/php artisan queue:work database --queue=node-ops --sleep=2 --tries=5 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=130
# 小机器上让队列任务给 Web 请求让路（只用优先级，不设内存硬上限，
# 上限会在内存吃紧时杀掉跑到一半的节点任务）
Nice=10
CPUWeight=20

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "$QUEUE_SERVICE" >/dev/null 2>&1
    systemctl restart "$QUEUE_SERVICE"

    local u
    for u in $(node_queue_units); do
        systemctl enable "$u" >/dev/null 2>&1
        systemctl restart "$u"
    done
}

# 配置 xray 节点 WS 长连接服务（3xui-hub-node-ws.service）
#
# 为什么每次 update 都重写单元文件 + 自愈安装：老版本（没有这个服务）升级上来时，
# 不装就会出现「agent 连不上 WS → 降级 HTTP 通道」，功能可用但实时性打折；
# 而且单元文件由脚本统一维护，避免线上手改漂移。restart 失败降级为告警不中断更新
# （WS 挂掉时 agent 会自动降级 HTTP，面板功能不受影响，不应该阻断整个升级流程）。
configure_node_ws() {
    if [ ! -f "$BACKEND_DIR/artisan" ]; then
        return 0
    fi

    NGINX_USER=$(ps -eo user,comm | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    # .env 显式写入开关（幂等；默认值即 true，写入是让管理员可见可控）
    if ! grep -q '^XRAY_WS_ENABLED=' "$BACKEND_DIR/.env" 2>/dev/null; then
        echo 'XRAY_WS_ENABLED=true' >> "$BACKEND_DIR/.env"
    fi

    cat > "/etc/systemd/system/$NODE_WS_SERVICE" << EOF
[Unit]
Description=3xui-hub Node WebSocket Server (xray nodes)
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=${NGINX_USER}
Group=${NGINX_USER}
WorkingDirectory=${BACKEND_DIR}
ExecStart=/usr/bin/php artisan node:ws-serve
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "$NODE_WS_SERVICE" >/dev/null 2>&1
    systemctl restart "$NODE_WS_SERVICE"

    # nginx 反代自愈：老版本升级上来的 conf 缺 /node-ws location，补上（幂等）
    ensure_nginx_node_ws

    if systemctl is-active --quiet "$NODE_WS_SERVICE"; then
        return 0
    fi
    return 1
}

# nginx /node-ws 反代自愈（幂等）
#
# 本功能发布前安装的老面板，3xui-hub.conf 里没有 /node-ws location —— agent 连 WS 会
# 404，自动降级 HTTP（功能可用但实时性打折）。这里在「location ~ ^/(api|admin-api)」
# 锚点前插入反代块，把 WS 通道补齐。
# 保护：改前备份、nginx -t 校验失败自动回滚，绝不破坏用户的 SSL / 自定义配置。
ensure_nginx_node_ws() {
    local CONF=""
    if [ -d /www/server/panel ] || [ -d /www/server/nginx ]; then
        CONF="/www/server/panel/vhost/nginx/3xui-hub.conf"
    else
        CONF="/etc/nginx/conf.d/3xui-hub.conf"
    fi
    [ -f "$CONF" ] || return 0
    grep -q '/node-ws' "$CONF" 2>/dev/null && grep -q 'node-install' "$CONF" 2>/dev/null && return 0

    cp -f "$CONF" "${CONF}.bak-nodews"
    python3 - "$CONF" <<'PY'
import sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    s = f.read()
blocks = ''
if '/node-ws' not in s:
    blocks += '''    # xray 节点 WS 长连接（agent 主通道；连不上时 agent 自动降级 HTTP）
    location /node-ws {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

'''
if 'node-install' not in s:
    blocks += '''    # xray 节点资产与安装脚本（转 PHP；否则被 SPA fallback 吞掉）
    location ~ ^/(node-install\\.sh|node-agent\\.sh|node-bin/) {
        try_files $uri $uri/ /index.php?$query_string;
    }

'''
if not blocks:
    sys.exit(0)  # 已有，无需处理
anchor = 'location ~ ^/(api|admin-api)'
idx = s.find(anchor)
if idx < 0:
    sys.exit(2)  # 找不到锚点，无法安全插入
line_start = s.rfind('\n', 0, idx) + 1
with open(path, "w", encoding="utf-8") as f:
    f.write(s[:line_start] + blocks + s[line_start:])
PY
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
            echo "Nginx 反代: 已补 /node-ws"
            rm -f "${CONF}.bak-nodews"
        else
            mv -f "${CONF}.bak-nodews" "$CONF"
            echo "Nginx 反代: 补丁未通过 nginx -t，已回滚（可手工添加 /node-ws）"
        fi
    else
        rm -f "${CONF}.bak-nodews"
        [ "$rc" -eq 2 ] && echo "Nginx 反代: 未找到 api|admin-api 锚点，跳过（请手工确认 /node-ws）"
    fi
}

# 修复 storage / bootstrap/cache 属主（幂等自愈）
#
# 为什么更新末尾要单独修一遍：任何以 root 身份跑过 artisan / composer 的动作，都会在这两个
# 目录里留下 root 属主文件 —— cmd_update 里的 composer install（会以 root 触发
# package:discover，往 bootstrap/cache 写 packages.php / services.php），以及运维手工敲的
# php artisan xxx / tinker（排查问题时最容易顺手敲出来）。之后以网站运行用户跑的调度器 /
# 队列 worker 再往 storage/framework/cache 写缓存就 Permission denied，schedule:run 静默失败
# → 定时任务全停 + 面板显示 worker 离线（BanCheckJob 不再写心跳缓存）。所以每次更新都要把
# 属主收回来，否则每更新一次就重新埋一颗雷。
#
# 安静且幂等：先扫一遍有没有非目标属主的文件，没有就一声不响地返回，不做多余动作。
# bootstrap/cache 不能漏 —— composer 的 root 属主文件正写在那里。
fix_storage_ownership() {
    local NGINX_USER BAD SCAN_RC=0 d
    local -a TARGETS=()

    # 用文件顶部的 BACKEND_DIR；与 run_artisan / configure_queue_worker 同一套用户判定
    NGINX_USER=$(ps -eo user,comm 2>/dev/null | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    for d in "$BACKEND_DIR/storage" "$BACKEND_DIR/bootstrap/cache"; do
        if [ -d "$d" ]; then
            TARGETS+=("$d")
        fi
    done
    if [ ${#TARGETS[@]} -eq 0 ]; then
        return 0
    fi

    # -print -quit：撞见第一个属主不对的就停，只有干净时才会走完整棵树
    BAD=$(find "${TARGETS[@]}" ! -user "$NGINX_USER" -print -quit 2>/dev/null) || SCAN_RC=$?

    # 干净：不动、不吭声。扫不出结果（权限不足 / 该用户不存在）时按「脏」处理 ——
    # 宁可多做一次幂等的 chown，也不要静默放过一次真实的污染。
    if [ "$SCAN_RC" -eq 0 ] && [ -z "$BAD" ]; then
        return 0
    fi

    # 非 root 改不了属主，chown 只会失败刷屏；说明原因后直接返回，不动任何文件
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "目录属主: ${YELLOW}跳过修复${NC}（存在非 ${NGINX_USER} 属主的缓存文件，如 ${BAD:-扫描失败}；需要 root 权限，请用 sudo 运行）"
        return 0
    fi

    if chown -R "$NGINX_USER":"$NGINX_USER" "${TARGETS[@]}" 2>/dev/null; then
        echo -e "目录属主: ${GREEN}已修复${NC}（storage/bootstrap/cache → ${NGINX_USER}，此前存在非 ${NGINX_USER} 属主文件，如 ${BAD:-扫描失败}）"
    else
        # 修不好也不中断更新：属主问题比起前面报过的错要轻，留提示让人工收尾即可
        echo -e "目录属主: ${YELLOW}修复失败${NC}，请以 root 手工执行: chown -R ${NGINX_USER}:${NGINX_USER} ${TARGETS[*]}"
    fi
    return 0
}

# 命令列表（编号对应）
CMDS=(
    "status"
    "check-update"
    "update"
    "admin-user"
    "admin-pass"
    "sync"
    "sync-status"
    "backup"
    "log"
    "restart"
    "ssl"
    "domain"
    "fix-nginx"
)

CMD_LABELS=(
    "查看系统状态"
    "检测更新"
    "更新系统"
    "修改管理员账号"
    "修改管理员密码"
    "手动同步流量"
    "查看自动同步状态"
    "导出数据库备份"
    "查看最近错误日志"
    "重启 PHP-FPM、Nginx 和队列 Worker"
    "配置域名和 SSL 证书"
    "多域名管理 (add/renew/remove/status)"
    "补全 nginx 节点资产 location（老版本升级后用）"
)

# 显示帮助
show_help() {
    echo -e "${CYAN}3hub${NC} - 3xui-hub 管理命令 v${VERSION}"
    echo ""
    echo "用法: 3hub [命令|编号]"
    echo ""
    echo "命令:"
    for i in "${!CMDS[@]}"; do
        printf "  ${GREEN}%2d${NC}  %-14s %s\n" $((i+1)) "${CMDS[$i]}" "${CMD_LABELS[$i]}"
    done
    echo ""
    echo "示例:"
    echo "  3hub status"
    echo "  3hub 1          # 等同于 3hub status"
    echo "  3hub domain add example.com"
}

# 查看状态
cmd_status() {
    check_install
    cd "$BACKEND_DIR"

    echo -e "${CYAN}=== 系统状态 ===${NC}"
    echo ""

    # 版本
    echo -e "版本:      ${GREEN}${VERSION}${NC}"

    # PHP
    PHP_VER=$(php -r 'echo PHP_VERSION;' 2>/dev/null)
    echo -e "PHP:       ${GREEN}${PHP_VER}${NC}"

    # 数据库
    if command -v mysql &>/dev/null; then
        DB_SIZE=$(mysql -u root controlhub -e "SELECT ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) AS size_mb FROM information_schema.tables WHERE table_schema = 'controlhub';" -sN 2>/dev/null)
        echo -e "数据库:    ${GREEN}${DB_SIZE} MB (MySQL)${NC}"
    else
        echo -e "数据库:    ${YELLOW}MySQL${NC}"
    fi

    # 统计
    echo ""
    echo -e "${CYAN}--- 数据统计 ---${NC}"
    run_artisan tinker --execute="
        echo '用户:      ' . \App\Models\User::count() . PHP_EOL;
        echo '服务器:    ' . \App\Models\Node::count() . PHP_EOL;
        echo '节点:      ' . \App\Models\NodeInbound::count() . PHP_EOL;
        echo '套餐:      ' . \App\Models\Plan::count() . PHP_EOL;
        echo '订单:      ' . \App\Models\Order::count() . PHP_EOL;
        echo '支付配置:  ' . \App\Models\PaymentConfig::count() . PHP_EOL;
    " 2>/dev/null

    # Nginx 状态
    echo ""
    if systemctl is-active nginx &>/dev/null; then
        echo -e "Nginx:     ${GREEN}运行中${NC}"
    else
        echo -e "Nginx:     ${RED}未运行${NC}"
    fi

    # PHP-FPM 状态
    if systemctl is-active php8.4-fpm &>/dev/null || pgrep -f "php-fpm" &>/dev/null; then
        echo -e "PHP-FPM:   ${GREEN}运行中${NC}"
    else
        echo -e "PHP-FPM:   ${RED}未运行${NC}"
    fi

    if systemctl is-active "$QUEUE_SERVICE" &>/dev/null; then
        echo -e "队列 Worker: ${GREEN}运行中${NC}（default，定时任务）"
    else
        echo -e "队列 Worker: ${RED}未运行${NC}（default，定时任务）"
    fi

    # 节点任务 Worker（node-ops）：按实例统计，可能被人工增减
    local NODE_TOTAL=0 NODE_ACTIVE=0 u
    for u in $(node_queue_units); do
        NODE_TOTAL=$((NODE_TOTAL + 1))
        if systemctl is-active "$u" &>/dev/null; then
            NODE_ACTIVE=$((NODE_ACTIVE + 1))
        fi
    done
    if [ "$NODE_TOTAL" -eq 0 ]; then
        echo -e "节点 Worker: ${YELLOW}未配置${NC}（node-ops）"
    elif [ "$NODE_ACTIVE" -eq "$NODE_TOTAL" ]; then
        echo -e "节点 Worker: ${GREEN}运行中${NC}（node-ops，${NODE_ACTIVE}/${NODE_TOTAL}）"
    elif [ "$NODE_ACTIVE" -eq 0 ]; then
        echo -e "节点 Worker: ${RED}未运行${NC}（node-ops，0/${NODE_TOTAL}）"
        echo -e "  ${YELLOW}节点任务会一直停在 pending，修复: 3hub update${NC}"
    else
        echo -e "节点 Worker: ${YELLOW}部分运行${NC}（node-ops，${NODE_ACTIVE}/${NODE_TOTAL}）"
    fi

    # xray 节点 WS 长连接服务（agent 主通道；未运行时节点自动走 HTTP 降级）
    if systemctl is-active "$NODE_WS_SERVICE" &>/dev/null; then
        echo -e "节点 WS 服务: ${GREEN}运行中${NC}（xray 节点实时通道）"
    else
        echo -e "节点 WS 服务: ${YELLOW}未运行${NC}（xray 节点走 HTTP 降级通道，修复: 3hub update）"
    fi
}

# 检测更新
cmd_check_update() {
    check_install
    cd "$INSTALL_DIR"

    echo -e "${CYAN}检查更新...${NC}"
    git fetch origin 2>/dev/null

    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main 2>/dev/null)

    if [ "$LOCAL" = "$REMOTE" ]; then
        echo -e "${GREEN}已是最新版本${NC}"
    else
        # 检查是否落后于远程（而不是领先）
        BEHIND=$(git rev-list --count HEAD..origin/main 2>/dev/null)
        if [ "$BEHIND" -gt 0 ] 2>/dev/null; then
            echo -e "${YELLOW}有新版本可用！${NC}（落后 ${BEHIND} 个提交）"
            echo ""
            git log --oneline HEAD..origin/main 2>/dev/null | head -10
            echo ""
            echo -e "运行 ${BLUE}3hub update${NC} 更新"
        else
            echo -e "${GREEN}已是最新版本${NC}（本地领先远程）"
        fi
    fi
}

# php-fpm 并发调优（pm.max_children）
#
# 发行版默认 www.conf 是 5（Debian/Ubuntu），面板一有并发就排队，是用户量上来后第一个卡的环节。
# 必须 root：要改 /etc/php/*/fpm/pool.d/www.conf 并 reload 系统服务，不能走 run_artisan 的降权
#（那个是给「会写 storage/ 属主」的 artisan 命令用的）。
# 幂等：当前值已等于推荐值时不改配置、不 reload。
cmd_fpm_tune() {
    check_install
    cd "$BACKEND_DIR" || return 1

    php artisan fpm:tune "$@"
}

# 更新系统
cmd_update() {
    check_install
    cd "$INSTALL_DIR"

    echo -e "${CYAN}更新中...${NC}"

    # 重置到远程最新版本（清理本地 merge 提交）
    git fetch origin 2>/dev/null
    git reset --hard origin/main 2>&1

    # 更新后端依赖
    cd "$BACKEND_DIR"
    COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --optimize-autoloader 2>&1

    # 迁移数据库
    run_artisan migrate --force 2>&1

    # 保障调度器 cron（幂等）：root crontab 常被 acme.sh / 面板等工具整体重写，
    # 更新路径必须每次自愈，否则 schedule:run 一丢就是「定时任务全停 + 心跳空白」
    echo -e "${CYAN}检查定时任务...${NC}"
    ensure_artisan_cron || echo -e "${YELLOW}定时任务未就绪，见上方提示${NC}"

    # 配置数据库队列和常驻 Worker
    configure_queue_worker

    # xray 节点 WS 长连接服务（自愈安装 + 重启；失败仅告警：agent 会降级 HTTP 通道）
    echo -e "${CYAN}检查节点 WS 服务...${NC}"
    if configure_node_ws; then
        echo -e "节点 WS 服务: ${GREEN}已就绪${NC}"
    else
        echo -e "${YELLOW}节点 WS 服务未就绪（节点将使用 HTTP 降级通道，不影响功能）${NC}"
        echo -e "${YELLOW}排查: systemctl status $NODE_WS_SERVICE${NC}"
    fi

    # 清除缓存
    run_artisan config:clear 2>&1
    run_artisan route:clear 2>&1
    run_artisan view:clear 2>&1
    run_artisan queue:restart 2>&1
    systemctl restart "$QUEUE_SERVICE"
    if ! systemctl is-active --quiet "$QUEUE_SERVICE"; then
        echo -e "${RED}后台任务 Worker 启动失败，请运行: systemctl status $QUEUE_SERVICE${NC}"
        return 1
    fi

    # 节点任务 Worker：上面的 configure_queue_worker 会重新生成模板单元并 enable，
    # 所以从老版本（那时还没有这个服务）升级上来也会被装上，这里再逐个 restart + 自检。
    # 必须自检：.env 开了 node-ops 而没有 worker 监听时，节点任务会被派进空队列，
    # 永远不执行且不报错（面板上一直 pending），比两类任务抢队列严重得多。
    for u in $(node_queue_units); do
        systemctl restart "$u"
        if ! systemctl is-active --quiet "$u"; then
            echo -e "${RED}节点任务 Worker ($u) 启动失败，请运行: systemctl status $u${NC}"
            return 1
        fi
    done

    # 复制前端文件
    cp -r "$INSTALL_DIR/frontend/dist/"* "$BACKEND_DIR/public/" 2>/dev/null || true

    # php-fpm 并发（pm.max_children）：发行版默认 5，用户量上来就排队，是第一个卡的地方。
    # 必须走子进程调「刚更新到盘上」的脚本：bash 启动时已把旧函数读进内存，直接调函数
    # 在老版本升级的那一次跑不到（同 ensure_nginx_node_ws 那个坑）。
    echo -e "${CYAN}检查 php-fpm 并发...${NC}"
    if ! bash "$INSTALL_DIR/3hub" __fpm-tune; then
        echo -e "${YELLOW}php-fpm 并发未调整（可手动执行: cd $BACKEND_DIR && php artisan fpm:tune）${NC}"
    fi

    # agent 自升级：把面板上这份 agent 二进制推给节点（节点自己下载 → sha256 校验 → 原子替换 →
    # 重启 agent）。离线节点也会入队，等它上线取走即执行 —— 不用登录每台 VPS。
    # 幂等：节点已上报同版本 / 已有在途指令 → 跳过，不会每次 update 都重启节点。
    echo -e "${CYAN}检查节点 agent 版本...${NC}"
    if ! run_artisan node:upgrade-agent; then
        echo -e "${YELLOW}agent 升级指令未下发（可手动执行: cd $BACKEND_DIR && php artisan node:upgrade-agent）${NC}"
    fi

    # 重启 PHP-FPM
    systemctl reload php8.4-fpm 2>/dev/null || pkill -USR2 php-fpm 2>/dev/null || true

    # 更新 3hub 命令本身
    cp "$INSTALL_DIR/3hub" /usr/local/bin/3hub
    chmod +x /usr/local/bin/3hub

    # 同步多域名助手（与 install.sh 的 install_domain_support 一致，覆盖更新）
    if [ -f "$INSTALL_DIR/3hub-domain" ]; then
        cp "$INSTALL_DIR/3hub-domain" /usr/local/bin/3hub-domain
        chmod +x /usr/local/bin/3hub-domain
        chown root:root /usr/local/bin/3hub-domain 2>/dev/null || true
    fi
    if [ -f "$INSTALL_DIR/sudoers-3xui-hub" ] && visudo -cf "$INSTALL_DIR/sudoers-3xui-hub" >/dev/null 2>&1; then
        cp "$INSTALL_DIR/sudoers-3xui-hub" /etc/sudoers.d/3xui-hub
        chmod 0440 /etc/sudoers.d/3xui-hub
        chown root:root /etc/sudoers.d/3xui-hub 2>/dev/null || true
    fi

    # 属主自愈：必须压在最后 —— 上面所有可能以 root 跑 artisan / composer 的步骤都跑完了
    #（composer install 的 package:discover、run_artisan 之外的任何手工 php artisan），
    # 这里把 storage / bootstrap/cache 的 root 属主文件收回网站运行用户名下。
    # 顺序上不能提到 config:clear 那类步骤之前，否则还会被后续步骤重新污染。详见函数注释。
    fix_storage_ownership

    # 从旧版本升上来的机器：本次运行的仍是旧脚本（bash 启动时已读入内存），
    # 所以本次新增/修改的自愈函数（如 ensure_nginx_node_ws）这一次跑不到。
    # 落盘检查并明确提示，避免用户以为已经自愈、实际要等下一条命令。
    if ! nginx_node_ws_applied; then
        echo ""
        echo -e "${YELLOW}⚠ 检测到 nginx 缺少节点资产 location（/node-ws、/node-install.sh）。${NC}"
        echo -e "${YELLOW}  这是老版本升级的已知情况：自愈函数要到下一次运行才可用。${NC}"
        echo -e "${YELLOW}  请执行一次：${NC} ${GREEN}3hub fix-nginx${NC}"
    fi

    echo -e "${GREEN}更新完成！${NC}"
}

# nginx 反代是否已就位（只读判断，供提示与 fix-nginx 复用）
nginx_conf_path() {
    if [ -d /www/server/panel ] || [ -d /www/server/nginx ]; then
        echo "/www/server/panel/vhost/nginx/3xui-hub.conf"
    else
        echo "/etc/nginx/conf.d/3xui-hub.conf"
    fi
}

nginx_node_ws_applied() {
    local CONF
    CONF="$(nginx_conf_path)"
    [ -f "$CONF" ] || return 0   # 没这份 conf 就不是本脚本该管的场景，视为无需处理
    grep -q '/node-ws' "$CONF" 2>/dev/null && grep -q 'node-install' "$CONF" 2>/dev/null
}

# 补 nginx 反代（给老版本升级上来的机器用；幂等，可反复执行）
cmd_fix_nginx() {
    echo -e "${CYAN}检查 nginx 节点资产 location...${NC}"
    if nginx_node_ws_applied; then
        echo -e "Nginx 反代: ${GREEN}已就位${NC}（无需处理）"
        return 0
    fi
    ensure_nginx_node_ws
    if nginx_node_ws_applied; then
        echo -e "Nginx 反代: ${GREEN}已补全${NC}"
        return 0
    fi
    echo -e "${RED}Nginx 反代: 未能补全${NC}，请检查 $(nginx_conf_path) 的写入权限或手工添加"
    return 1
}

