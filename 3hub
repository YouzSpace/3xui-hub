# 查看日志
cmd_log() {
    check_install
    LOG_FILE="$BACKEND_DIR/storage/logs/laravel.log"

    if [ ! -f "$LOG_FILE" ]; then
        echo -e "${YELLOW}暂无日志${NC}"
        return
    fi

    echo -e "${CYAN}=== 最近错误日志 ===${NC}"
    grep -i "ERROR\|EXCEPTION\|CRITICAL" "$LOG_FILE" 2>/dev/null | tail -20

    if [ ! -s "$LOG_FILE" ]; then
        echo -e "${GREEN}暂无错误${NC}"
    fi

    # 队列 Worker 的单元日志：worker 被 OOM/超时杀掉后自动重启这类事只记在 journal 里，
    # laravel.log 上看不到（Job 失败栈在 laravel.log，进程级问题在这里）
    if command -v journalctl &>/dev/null; then
        local JOURNAL_ARGS=(-u "$QUEUE_SERVICE") u
        for u in $(node_queue_units); do
            JOURNAL_ARGS+=(-u "$u")
        done
        echo ""
        echo -e "${CYAN}=== 队列 Worker 最近日志（default + node-ops） ===${NC}"
        journalctl "${JOURNAL_ARGS[@]}" --no-pager -n 20 2>/dev/null || true
    fi
}

