cmd_domain_usage() {
    echo -e "${CYAN}用法:${NC} 3hub domain {add|renew|remove|status} <域名>"
    echo ""
    echo -e "  ${GREEN}add${NC}    <域名>  登记域名并申请证书（等效面板「添加域名」）"
