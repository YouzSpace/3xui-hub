#!/bin/bash
# ============================================================
# 3hub - 3xui-hub 管理命令
# ============================================================

VERSION="1.0.0"
INSTALL_DIR="/www/wwwroot/3xui-hub"
BACKEND_DIR="${INSTALL_DIR}/backend"
# 数据库备份目录：与 backend/config/backup.php 的默认值保持一致（env BACKUP_DIR 可覆盖）
BACKUP_DIR="/var/backups/3xui-hub"
QUEUE_SERVICE="3xui-hub-queue.service"
# 节点任务专用队列（node-ops）的 worker：模板单元 + 实例编号，命令只写一份。
# 实例数运行期自适应（见 node_queue_instances_for_mem / resolve_node_queue_instances）：
# 覆盖文件 /etc/3xui-hub/node-queue-instances 优先，否则 MemTotal <1024MB → 1 个、否则 2 个。
# status/restart/update 都跟随同一份名单（详见 INSTALL.md「队列与并发」）。
NODE_QUEUE_TEMPLATE="3xui-hub-queue-node@"
NODE_QUEUE_UNIT_FILE="/etc/systemd/system/3xui-hub-queue-node@.service"
NODE_QUEUE_UNIT_DIR="/etc/systemd/system/multi-user.target.wants"
NODE_QUEUE_INSTANCES_FILE="/etc/3xui-hub/node-queue-instances"
# 占位默认值；实际值在脚本底部（命令分发前）由 resolve_node_queue_instances 覆盖
NODE_QUEUE_INSTANCES="1 2"
# 邮件专用队列（mail）的 worker：单实例。
# 邮件任务（自动通知/群发/每月定时）与控制类定时任务（封禁检查、健康检查）挤在同一条
# default 队列时，一条单线程 worker 会被一次群发独占十几分钟，5 分钟定时任务只能排队 ——
# 到期/超量用户因此没有及时被关掉 3x-ui 流量。邮件单独一条队列后堵不到控制类任务。
MAIL_QUEUE_SERVICE="3xui-hub-queue-mail.service"
# xray 节点 WebSocket 长连接服务（Workerman 常驻；nginx 反代 /node-ws → 127.0.0.1:8091）
NODE_WS_SERVICE="3xui-hub-node-ws.service"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查安装
check_install() {
    if [ ! -f "$BACKEND_DIR/artisan" ]; then
        echo -e "${RED}错误: 3xui-hub 未安装或安装目录不正确${NC}"
        exit 1
    fi
}

# node-ops 实例数规则（纯函数，入参 mem_mb，只回显列表）：<1024MB → 1，否则 2。
# 与 install.sh 里的 node_instance_count_for_mem 同一规则；分开两处保持各自可独立运行。
node_queue_instances_for_mem() {
    local mem_mb="${1:-0}"
    if [ "$mem_mb" -lt 1024 ] 2>/dev/null; then
        echo "1"
    else
        echo "1 2"
    fi
}

# 解析本机该开几个 node-ops 实例：覆盖文件优先（含数字，空格分隔），否则按 MemTotal 自适应。
resolve_node_queue_instances() {
    local mem_mb
    if [ -f "$NODE_QUEUE_INSTANCES_FILE" ] && grep -q '[0-9]' "$NODE_QUEUE_INSTANCES_FILE" 2>/dev/null; then
        tr -s ' \t\n' ' ' < "$NODE_QUEUE_INSTANCES_FILE" | sed -e 's/^ *//' -e 's/ *$//'
        return 0
    fi
    mem_mb=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
    node_queue_instances_for_mem "$mem_mb"
}

# 关闭「已 enabled 但不在名单内」的 node-ops 实例（老机器升级后 2→1 时残留的 @2 必须停掉）。
# 来源是 multi-user.target.wants 下的软链，不写死 1..N —— 人工 enable 过 @3 也能被收敛。
converge_node_queue_instances() {
    local keep="$1" link inst i
    for link in "$NODE_QUEUE_UNIT_DIR"/3xui-hub-queue-node@*.service; do
        [ -e "$link" ] || continue
        inst="${link##*/3xui-hub-queue-node@}"
        inst="${inst%.service}"
        for i in $keep; do
            [ "$i" = "$inst" ] && continue 2
        done
        systemctl disable --now "3xui-hub-queue-node@${inst}.service" 2>/dev/null || true
    done
}

# 展开 node-ops worker 的实例单元名（3xui-hub-queue-node@1.service ...）
node_queue_units() {
    local i
    for i in $NODE_QUEUE_INSTANCES; do
        echo "${NODE_QUEUE_TEMPLATE}${i}.service"
    done
}

# artisan 必须以网站运行用户执行：root 跑会往 storage/bootstrap/cache
# 写 root 属主文件，导致 www-data 的队列 worker 间歇性 Permission denied
run_artisan() {
    local NGINX_USER
    NGINX_USER=$(ps -eo user,comm | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}
    sudo -u "$NGINX_USER" php artisan "$@"
}

# 保障 Laravel 调度器 cron（幂等）：
#   已有 artisan schedule:run 条目 → 原样不动；缺失 → 合并式补写并回显
# 为什么要在更新/自检路径反复保障：root crontab 会被 acme.sh 安装、面板自带 cron
# 管理、其它运维脚本整体重写掉。一旦 schedule:run 丢了，traffic:sync / ban-check /
# health-check / traffic:monthly-reset / async-task-timeout 全部停摆，BanCheckJob 不再
# 写 worker 心跳缓存，后台「系统状态」就会一直显示 worker 离线（其实 worker 好着）。
# 返回 0=已配置（含本次补写），1=需要人工处理（无权限 / 写入失败）
ensure_artisan_cron() {
    local NGINX_USER CRON_CMD CURRENT

    # 必须用网站运行用户执行：root 直跑会持续往 storage/framework/cache 写 root 属主
    # 缓存文件，导致 www-data 的队列 worker 间歇性 Permission denied
    NGINX_USER=$(ps -eo user,comm 2>/dev/null | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    CRON_CMD="* * * * * sudo -u ${NGINX_USER} bash -c 'cd ${BACKEND_DIR} && php artisan schedule:run >> /dev/null 2>&1'"

    CURRENT=$(crontab -l 2>/dev/null)
    if printf '%s\n' "$CURRENT" | grep -q "artisan schedule:run"; then
        echo -e "Cron 定时任务: ${GREEN}已配置${NC}（schedule:run 以 ${NGINX_USER} 运行）"
        return 0
    fi

    # 非 root 只提示不改写：那样写进的是当前用户自己的 crontab，看似修复实则永不生效
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "Cron 定时任务: ${YELLOW}未配置${NC}（写入 root crontab 需要 root 权限，请用 sudo 运行）"
        return 1
    fi

    # 合并式写入：只剔除同名旧条目再追加，acme.sh 等其它条目必须原样保留。
    # 绝不能用 `crontab <文件>` 整体覆盖——那会把别人的条目一并吞掉。
    if ! { [ -n "$CURRENT" ] && printf '%s\n' "$CURRENT" | grep -v "artisan schedule:run"; echo "$CRON_CMD"; } | crontab -; then
        echo -e "Cron 定时任务: ${RED}写入失败${NC}，请手工执行 crontab -e 添加："
        echo "  $CRON_CMD"
        return 1
    fi

    echo -e "Cron 定时任务: ${GREEN}已自动补配${NC}（schedule:run 以 ${NGINX_USER} 运行，此前缺失）"
    return 0
}

configure_queue_worker() {
    NGINX_USER=$(ps -eo user,comm | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    if grep -q '^QUEUE_CONNECTION=' "$BACKEND_DIR/.env"; then
        sed -i 's/^QUEUE_CONNECTION=.*/QUEUE_CONNECTION=database/' "$BACKEND_DIR/.env"
    else
        echo 'QUEUE_CONNECTION=database' >> "$BACKEND_DIR/.env"
    fi
    if grep -q '^DB_QUEUE_RETRY_AFTER=' "$BACKEND_DIR/.env"; then
        sed -i 's/^DB_QUEUE_RETRY_AFTER=.*/DB_QUEUE_RETRY_AFTER=180/' "$BACKEND_DIR/.env"
    else
        echo 'DB_QUEUE_RETRY_AFTER=180' >> "$BACKEND_DIR/.env"
    fi

    # 节点类 Job 走独立队列 node-ops。已有该行则改写，没有才追加（不重复追加：
    # dotenv 以最后一行为准，重复行会让旧值残留在文件里，排查时极易看错）。
    # 顺序上必须排在下面启动 worker 之前，否则会先出现「worker 监听 node-ops、
    # Job 仍往 default 派」的空转窗口。
    if grep -q '^PANEL_NODE_OPS_QUEUE=' "$BACKEND_DIR/.env"; then
        sed -i 's/^PANEL_NODE_OPS_QUEUE=.*/PANEL_NODE_OPS_QUEUE=node-ops/' "$BACKEND_DIR/.env"
    else
        echo 'PANEL_NODE_OPS_QUEUE=node-ops' >> "$BACKEND_DIR/.env"
    fi

    # 邮件类 Job 走独立队列 mail（同款幂等写法，同样必须排在启动 worker 之前）
    if grep -q '^PANEL_MAIL_QUEUE=' "$BACKEND_DIR/.env"; then
        sed -i 's/^PANEL_MAIL_QUEUE=.*/PANEL_MAIL_QUEUE=mail/' "$BACKEND_DIR/.env"
    else
        echo 'PANEL_MAIL_QUEUE=mail' >> "$BACKEND_DIR/.env"
    fi

    chown "$NGINX_USER":"$NGINX_USER" "$BACKEND_DIR/.env" 2>/dev/null || true
    chmod 640 "$BACKEND_DIR/.env" 2>/dev/null || true
    chown -R "$NGINX_USER":"$NGINX_USER" "$BACKEND_DIR/storage" "$BACKEND_DIR/bootstrap/cache" 2>/dev/null || true
    chmod -R 775 "$BACKEND_DIR/storage" "$BACKEND_DIR/bootstrap/cache" 2>/dev/null || true

    cat > "/etc/systemd/system/$QUEUE_SERVICE" << EOF
[Unit]
Description=3xui-hub Queue Worker
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=${NGINX_USER}
Group=${NGINX_USER}
WorkingDirectory=${BACKEND_DIR}
ExecStart=/usr/bin/php artisan queue:work database --sleep=2 --tries=5 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=130

[Install]
WantedBy=multi-user.target
EOF

    # node-ops worker：模板单元 + 实例编号，命令行只写一份，实例共用，
    # 避免两份文件只改一份导致某个实例漏掉 --queue=node-ops 而和 default worker 抢同一条队列。
    cat > "$NODE_QUEUE_UNIT_FILE" << EOF
[Unit]
Description=3xui-hub Node Ops Queue Worker (instance %i)
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=${NGINX_USER}
Group=${NGINX_USER}
WorkingDirectory=${BACKEND_DIR}
ExecStart=/usr/bin/php artisan queue:work database --queue=node-ops --sleep=2 --tries=5 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=130
# 小机器上让队列任务给 Web 请求让路（只用优先级，不设内存硬上限，
# 上限会在内存吃紧时杀掉跑到一半的节点任务）
Nice=10
CPUWeight=20

[Install]
WantedBy=multi-user.target
EOF

    # mail worker：单实例。发信是 IO 等待型（每封 1~3 秒都在等 SMTP），一条 worker
    # 的吞吐已超过常见 SMTP 服务商的限速，多开只会互相抢同一个发信账号。
    cat > "/etc/systemd/system/$MAIL_QUEUE_SERVICE" << EOF
[Unit]
Description=3xui-hub Mail Queue Worker
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=${NGINX_USER}
Group=${NGINX_USER}
WorkingDirectory=${BACKEND_DIR}
ExecStart=/usr/bin/php artisan queue:work database --queue=mail --sleep=2 --tries=5 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=130
Nice=10
CPUWeight=20

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "$QUEUE_SERVICE" >/dev/null 2>&1
    systemctl restart "$QUEUE_SERVICE"

    local u
    for u in $(node_queue_units); do
        systemctl enable "$u" >/dev/null 2>&1
        systemctl restart "$u"
    done
    # 收敛：名单外但已 enabled 的实例（如老机器升级后 2→1 残留的 @2）显式停掉
    converge_node_queue_instances "$NODE_QUEUE_INSTANCES"

    systemctl enable "$MAIL_QUEUE_SERVICE" >/dev/null 2>&1
    systemctl restart "$MAIL_QUEUE_SERVICE"
}

# 配置 xray 节点 WS 长连接服务（3xui-hub-node-ws.service）
#
# 为什么每次 update 都重写单元文件 + 自愈安装：老版本（没有这个服务）升级上来时，
# 不装就会出现「agent 连不上 WS → 降级 HTTP 通道」，功能可用但实时性打折；
# 而且单元文件由脚本统一维护，避免线上手改漂移。restart 失败降级为告警不中断更新
# （WS 挂掉时 agent 会自动降级 HTTP，面板功能不受影响，不应该阻断整个升级流程）。
configure_node_ws() {
    if [ ! -f "$BACKEND_DIR/artisan" ]; then
        return 0
    fi

    NGINX_USER=$(ps -eo user,comm | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    # .env 显式写入开关（幂等；默认值即 true，写入是让管理员可见可控）
    if ! grep -q '^XRAY_WS_ENABLED=' "$BACKEND_DIR/.env" 2>/dev/null; then
        echo 'XRAY_WS_ENABLED=true' >> "$BACKEND_DIR/.env"
    fi

    cat > "/etc/systemd/system/$NODE_WS_SERVICE" << EOF
[Unit]
Description=3xui-hub Node WebSocket Server (xray nodes)
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=${NGINX_USER}
Group=${NGINX_USER}
WorkingDirectory=${BACKEND_DIR}
ExecStart=/usr/bin/php artisan node:ws-serve
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "$NODE_WS_SERVICE" >/dev/null 2>&1
    systemctl restart "$NODE_WS_SERVICE"

    # nginx 反代自愈：老版本升级上来的 conf 缺 /node-ws location，补上（幂等）
    ensure_nginx_node_ws

    if systemctl is-active --quiet "$NODE_WS_SERVICE"; then
        return 0
    fi
    return 1
}

# nginx /node-ws 反代自愈（幂等）
#
# 本功能发布前安装的老面板，3xui-hub.conf 里没有 /node-ws location —— agent 连 WS 会
# 404，自动降级 HTTP（功能可用但实时性打折）。这里在「location ~ ^/(api|admin-api)」
# 锚点前插入反代块，把 WS 通道补齐。
# 保护：改前备份、nginx -t 校验失败自动回滚，绝不破坏用户的 SSL / 自定义配置。
ensure_nginx_node_ws() {
    local CONF=""
    if [ -d /www/server/panel ] || [ -d /www/server/nginx ]; then
        CONF="/www/server/panel/vhost/nginx/3xui-hub.conf"
    else
        CONF="/etc/nginx/conf.d/3xui-hub.conf"
    fi
    [ -f "$CONF" ] || return 0
    grep -q '/node-ws' "$CONF" 2>/dev/null && grep -q 'node-install' "$CONF" 2>/dev/null && return 0

    cp -f "$CONF" "${CONF}.bak-nodews"
    python3 - "$CONF" <<'PY'
import sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    s = f.read()
blocks = ''
if '/node-ws' not in s:
    blocks += '''    # xray 节点 WS 长连接（agent 主通道；连不上时 agent 自动降级 HTTP）
    location /node-ws {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

'''
if 'node-install' not in s:
    blocks += '''    # xray 节点资产与安装脚本（转 PHP；否则被 SPA fallback 吞掉）
    location ~ ^/(node-install\\.sh|node-agent\\.sh|node-bin/) {
        try_files $uri $uri/ /index.php?$query_string;
    }

'''
if not blocks:
    sys.exit(0)  # 已有，无需处理
anchor = 'location ~ ^/(api|admin-api)'
idx = s.find(anchor)
if idx < 0:
    sys.exit(2)  # 找不到锚点，无法安全插入
line_start = s.rfind('\n', 0, idx) + 1
with open(path, "w", encoding="utf-8") as f:
    f.write(s[:line_start] + blocks + s[line_start:])
PY
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
            echo "Nginx 反代: 已补 /node-ws"
            rm -f "${CONF}.bak-nodews"
        else
            mv -f "${CONF}.bak-nodews" "$CONF"
            echo "Nginx 反代: 补丁未通过 nginx -t，已回滚（可手工添加 /node-ws）"
        fi
    else
        rm -f "${CONF}.bak-nodews"
        [ "$rc" -eq 2 ] && echo "Nginx 反代: 未找到 api|admin-api 锚点，跳过（请手工确认 /node-ws）"
    fi
}

# nginx 前端缓存规则自愈（幂等）
#
# 为什么需要：Vite 产物文件名带内容哈希，index.html 决定去加载哪批 chunk。
# 若 index.html 没有 Cache-Control，浏览器会按启发式规则自行长期缓存它 —— 升级后
# 浏览器仍拿旧 index 去找旧 chunk，而旧 chunk 在服务器上未必已被清理，于是静默加载
# 一套新旧混杂的前端：页面能开、不报错，但个别功能区块空白，极难排查。
# 给 index.html 加 no-cache、给 /assets/ 加长缓存即可根治。
#
# 覆盖范围：主 conf（3xui-hub.conf）+ 多域名 conf（3xui-hub-domains.conf，表驱动整份
# 重建、存量文件同样要自愈）。锚点用「SPA fallback 完整块」（location / 紧跟
# try_files …/index.html），逐个 server 段补齐 —— 不会误插进只做 301 跳转的 80 段。
# 保护：改前备份、nginx -t 校验失败自动回滚，绝不破坏用户的 SSL / 自定义配置。
ensure_nginx_cache_rules() {
    local main_conf
    main_conf="$(nginx_conf_path)"
    _cache_rules_patch_file "$main_conf"
    _cache_rules_patch_file "$(dirname "$main_conf")/3xui-hub-domains.conf"
    return 0
}

# 对单个 conf 补缓存规则（幂等；文件不存在 / 已含规则则跳过）
_cache_rules_patch_file() {
    local CONF="$1"
    [ -f "$CONF" ] || return 0
    grep -q 'location = /index.html' "$CONF" 2>/dev/null && return 0

    cp -f "$CONF" "${CONF}.bak-cache"
    python3 - "$CONF" <<'PY'
import re
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    s = f.read()

if 'location = /index.html' in s:
    sys.exit(0)  # 已有，无需处理

blocks = '''    # 带内容哈希的构建产物：内容变了文件名必变，可放心长缓存。
    location /assets/ {
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # SPA 入口：绝不能缓存（否则升级后可能拿旧 index 加载旧 chunk）。
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

'''

# 锚点 = SPA fallback 的完整 location 块（含 try_files …/index.html）：
# 80 段「location / { return 301 ... }」这类跳转块不会被命中；
# 命中多个（多域名 conf 每个域名一个 443 段）则逐个补齐。
pattern = re.compile(r'([ \t]*)location / \{[ \t]*\n[ \t]*try_files \$uri \$uri/ /index\.html;')
s, count = pattern.subn(lambda m: blocks + m.group(0), s)

if count == 0:
    # 兜底：自定义 conf 结构 → 退回「第一个 location / {」前的旧锚点（保持旧行为）。
    idx = s.find('location / {')
    if idx < 0:
        idx = s.find('location ~ ^/(api|admin-api)')
    if idx < 0:
        sys.exit(2)
    line_start = s.rfind('\n', 0, idx) + 1
    s = s[:line_start] + blocks + s[line_start:]

with open(path, "w", encoding="utf-8") as f:
    f.write(s)
PY
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
            echo "Nginx 缓存: $(basename "${CONF}") 已补 index.html no-cache + /assets/ 长缓存"
            rm -f "${CONF}.bak-cache"
        else
            mv -f "${CONF}.bak-cache" "$CONF"
            echo "Nginx 缓存: $(basename "${CONF}") 补丁未通过 nginx -t，已回滚"
        fi
    else
        rm -f "${CONF}.bak-cache"
        [ "$rc" -eq 2 ] && echo "Nginx 缓存: $(basename "${CONF}") 未找到插入锚点，跳过"
    fi
    return 0
}

# nginx gzip 自愈（幂等）
#
# 为什么需要：系统 nginx.conf 的 gzip_types 常被注释掉（nginx 默认只压 text/html），
# 表现为「index.html 被压缩、JS/CSS 原样传输」。JS/CSS/JSON 是面板最大的静态资源，
# 实测 gzip 后可省 60~75% 体积，弱网/跨境链路改善明显。
# gzip 指令在 http/server/location 上下文均合法，这里放 server 段内 —— 不受系统配置影响。
# 保护：改前备份、nginx -t 校验失败自动回滚，绝不破坏用户的 SSL / 自定义配置。
ensure_nginx_gzip() {
    local main_conf
    main_conf="$(nginx_conf_path)"
    _gzip_patch_file "$main_conf"
    _gzip_patch_file "$(dirname "$main_conf")/3xui-hub-domains.conf"
    return 0
}

# 对单个 conf 补 gzip 指令（幂等；文件不存在 / 已含 gzip_types 则跳过）
_gzip_patch_file() {
    local CONF="$1"
    [ -f "$CONF" ] || return 0
    grep -q 'gzip_types' "$CONF" 2>/dev/null && return 0

    cp -f "$CONF" "${CONF}.bak-gzip"
    python3 - "$CONF" <<'PY'
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    s = f.read()

if 'gzip_types' in s:
    sys.exit(0)  # 已有，无需处理

block = '''    # 文本资源 gzip：系统 nginx.conf 的 gzip_types 常被注释掉（默认只压 text/html），
    # JS/CSS/JSON 会原样传输；放 server 段内不受系统配置影响（实测省 60~75% 体积）。
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml text/xml application/xml+rss text/javascript image/svg+xml font/ttf font/otf font/woff2;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
'''

# 锚点 = 每个业务 server 段的「index index.html index.php;」行（80 跳转段没有该行）；
# 命中多个（多域名 conf 每个域名一个 443 段）则逐个补齐。
needle = '    index index.html index.php;\n'
if needle not in s:
    sys.exit(2)
s = s.replace(needle, needle + '\n' + block)

with open(path, "w", encoding="utf-8") as f:
    f.write(s)
PY
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
            echo "Nginx gzip: $(basename "${CONF}") 已补文本资源压缩（JS/CSS/JSON）"
            rm -f "${CONF}.bak-gzip"
        else
            mv -f "${CONF}.bak-gzip" "$CONF"
            echo "Nginx gzip: $(basename "${CONF}") 补丁未通过 nginx -t，已回滚"
        fi
    else
        rm -f "${CONF}.bak-gzip"
        [ "$rc" -eq 2 ] && echo "Nginx gzip: $(basename "${CONF}") 未找到插入锚点，跳过"
    fi
    return 0
}

# 修复 storage / bootstrap/cache 属主（幂等自愈）
#
# 为什么更新末尾要单独修一遍：任何以 root 身份跑过 artisan / composer 的动作，都会在这两个
# 目录里留下 root 属主文件 —— cmd_update 里的 composer install（会以 root 触发
# package:discover，往 bootstrap/cache 写 packages.php / services.php），以及运维手工敲的
# php artisan xxx / tinker（排查问题时最容易顺手敲出来）。之后以网站运行用户跑的调度器 /
# 队列 worker 再往 storage/framework/cache 写缓存就 Permission denied，schedule:run 静默失败
# → 定时任务全停 + 面板显示 worker 离线（BanCheckJob 不再写心跳缓存）。所以每次更新都要把
# 属主收回来，否则每更新一次就重新埋一颗雷。
#
# 安静且幂等：先扫一遍有没有非目标属主的文件，没有就一声不响地返回，不做多余动作。
# bootstrap/cache 不能漏 —— composer 的 root 属主文件正写在那里。
fix_storage_ownership() {
    local NGINX_USER BAD SCAN_RC=0 d
    local -a TARGETS=()

    # 用文件顶部的 BACKEND_DIR；与 run_artisan / configure_queue_worker 同一套用户判定
    NGINX_USER=$(ps -eo user,comm 2>/dev/null | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    for d in "$BACKEND_DIR/storage" "$BACKEND_DIR/bootstrap/cache"; do
        if [ -d "$d" ]; then
            TARGETS+=("$d")
        fi
    done
    if [ ${#TARGETS[@]} -eq 0 ]; then
        return 0
    fi

    # -print -quit：撞见第一个属主不对的就停，只有干净时才会走完整棵树
    BAD=$(find "${TARGETS[@]}" ! -user "$NGINX_USER" -print -quit 2>/dev/null) || SCAN_RC=$?

    # 干净：不动、不吭声。扫不出结果（权限不足 / 该用户不存在）时按「脏」处理 ——
    # 宁可多做一次幂等的 chown，也不要静默放过一次真实的污染。
    if [ "$SCAN_RC" -eq 0 ] && [ -z "$BAD" ]; then
        return 0
    fi

    # 非 root 改不了属主，chown 只会失败刷屏；说明原因后直接返回，不动任何文件
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "目录属主: ${YELLOW}跳过修复${NC}（存在非 ${NGINX_USER} 属主的缓存文件，如 ${BAD:-扫描失败}；需要 root 权限，请用 sudo 运行）"
        return 0
    fi

    if chown -R "$NGINX_USER":"$NGINX_USER" "${TARGETS[@]}" 2>/dev/null; then
        echo -e "目录属主: ${GREEN}已修复${NC}（storage/bootstrap/cache → ${NGINX_USER}，此前存在非 ${NGINX_USER} 属主文件，如 ${BAD:-扫描失败}）"
    else
        # 修不好也不中断更新：属主问题比起前面报过的错要轻，留提示让人工收尾即可
        echo -e "目录属主: ${YELLOW}修复失败${NC}，请以 root 手工执行: chown -R ${NGINX_USER}:${NGINX_USER} ${TARGETS[*]}"
    fi
    return 0
}

# 保障备份目录存在且属主正确（幂等）。
# 为什么需要在更新/安装路径保障：调度器每天 03:30 以网站运行用户跑 backup:run，
# 目录不存在或属主是 root 时每次备份都会失败 —— 而且是在凌晨静默失败，没人会发现。
ensure_backup_dir() {
    local NGINX_USER BAD_SCAN_RC=0

    # 与 run_artisan / fix_storage_ownership 同一套用户判定
    NGINX_USER=$(ps -eo user,comm 2>/dev/null | grep nginx | awk '{print $1}' | grep -v root | head -1)
    NGINX_USER=${NGINX_USER:-www-data}

    if [ -d "$BACKUP_DIR" ]; then
        # 已存在：只在属主不对时修（扫不出结果按「脏」处理，与 fix_storage_ownership 同口径）
        BAD=$(find "$BACKUP_DIR" ! -user "$NGINX_USER" -print -quit 2>/dev/null) || BAD_SCAN_RC=$?
        if [ "$BAD_SCAN_RC" -eq 0 ] && [ -z "$BAD" ]; then
            return 0
        fi
    else
        mkdir -p "$BACKUP_DIR" 2>/dev/null || true
    fi

    if [ ! -d "$BACKUP_DIR" ]; then
        echo -e "备份目录: ${YELLOW}创建失败${NC}（请手工执行: mkdir -p ${BACKUP_DIR}）"
        return 0
    fi

    # 非 root 改不了属主；mkdir 出来的目录通常已经是当前用户，无需再 chown
    if [ "$(id -u)" -ne 0 ]; then
        chown "$NGINX_USER":"$NGINX_USER" "$BACKUP_DIR" 2>/dev/null || true
        return 0
    fi

    if chown "$NGINX_USER":"$NGINX_USER" "$BACKUP_DIR" 2>/dev/null; then
        echo -e "备份目录: ${GREEN}已就绪${NC}（${BACKUP_DIR} → ${NGINX_USER}）"
    else
        echo -e "备份目录: ${YELLOW}属主未修正${NC}，请手工执行: chown ${NGINX_USER}:${NGINX_USER} ${BACKUP_DIR}"
    fi
    return 0
}

# 遗留超大 laravel.log 归档（幂等）。日志改为按天轮转后，新日志写 laravel-YYYY-MM-DD.log，
# 旧的 laravel.log 不再增长；但升级上来的机器它可能已经是几十 MB，白占空间。
# 超过 5MB 就整体改名 laravel-legacy-<时间戳>.log：保留（不丢历史）但不再增长，
# 轮转后的新日志由 Laravel daily 驱动接管，14 天自动清理。
rotate_legacy_laravel_log() {
    local LOG_FILE SIZE THRESHOLD=5242880   # 5MB

    LOG_FILE="$BACKEND_DIR/storage/logs/laravel.log"
    [ -f "$LOG_FILE" ] || return 0

    SIZE=$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)
    [ "$SIZE" -gt "$THRESHOLD" ] 2>/dev/null || return 0

    local ARCHIVE="$BACKEND_DIR/storage/logs/laravel-legacy-$(date +%Y%m%d%H%M%S).log"
    if mv "$LOG_FILE" "$ARCHIVE" 2>/dev/null; then
        echo -e "遗留日志: ${GREEN}已归档${NC}（laravel.log $(du -h "$ARCHIVE" 2>/dev/null | awk '{print $1}') → ${ARCHIVE##*/}）"
    else
        echo -e "遗留日志: ${YELLOW}归档失败${NC}，请手工检查 ${LOG_FILE} 的权限"
    fi
    return 0
}

